{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mjtechguy/blaxsmith/docs/extension-manifest.schema.json",
  "title": "Blaxsmith extension manifest (blaxsmith-extension.json), blaxsmith.extension/v1alpha1",
  "description": "Structural schema. internal/extension adds semantic checks: unique ids, cross-references, and paths that must exist at the pinned commit. See docs/extensions-and-runtimes.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "publisher", "harnesses", "stage_templates"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "blaxsmith.extension/v1alpha1"},
    "id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})(-[0-9A-Za-z.-]{1,64})?$"},
    "publisher": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {"name": {"$ref": "#/$defs/text"}, "url": {"type": "string", "pattern": "^https://", "maxLength": 2048}}
    },
    "description": {"type": "string", "maxLength": 2000},
    "harnesses": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["harness", "capabilities"],
        "properties": {
          "harness": {"$ref": "#/$defs/harness"},
          "min_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}}
        }
      }
    },
    "runtimes": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "version"],
        "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"type": "string", "minLength": 1, "maxLength": 64}}
      }
    },
    "egress": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["host", "port", "purpose"],
        "properties": {
          "host": {"type": "string", "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$", "maxLength": 253},
          "port": {"type": "integer", "enum": [443]},
          "purpose": {"$ref": "#/$defs/text"}
        }
      }
    },
    "native_subagents": {"type": "boolean"},
    "plugins": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "path"],
        "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/path"}}
      }
    },
    "stage_templates": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "mode", "harness", "kinds", "prompt"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "title": {"$ref": "#/$defs/text"},
          "mode": {"enum": ["embedded", "decomposed"]},
          "harness": {"$ref": "#/$defs/harness"},
          "kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["plan", "interview", "research", "implement", "review", "verify", "integrate", "ui_review", "documentation", "architect_review"]}},
          "plugins": {"$ref": "#/$defs/idList"},
          "entrypoint": {"type": "string", "pattern": "^/[a-z0-9-]+:[a-z0-9-]+$"},
          "prompt": {"type": "string", "minLength": 1, "maxLength": 8192},
          "skills": {"type": "array", "items": {"$ref": "#/$defs/path"}},
          "rules": {"$ref": "#/$defs/idList"},
          "agents": {"$ref": "#/$defs/idList"},
          "mcp_servers": {"$ref": "#/$defs/idList"},
          "hooks": {"$ref": "#/$defs/idList"},
          "interactions": {"$ref": "#/$defs/idList"},
          "signals": {
            "type": "array", "maxItems": 16,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["plugin", "server", "tool", "event", "name_field"],
              "properties": {
                "plugin": {"$ref": "#/$defs/id"},
                "server": {"$ref": "#/$defs/id"},
                "tool": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
                "event": {"enum": ["phase", "handoff", "cycle", "progress"]},
                "name_field": {"type": "string", "pattern": "^[a-z_]{1,64}$"},
                "text_field": {"type": "string", "pattern": "^[a-z_]{1,64}$"}
              }
            }
          }
        }
      }
    },
    "recipes": {"type": "array", "items": {"$ref": "#/$defs/idPath"}},
    "skills": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"$ref": "#/$defs/path"}}}},
    "rules": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "path"],
        "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/path"}, "applies_to": {"type": "array", "items": {"type": "string", "maxLength": 256}}}
      }
    },
    "agents": {"type": "array", "items": {"$ref": "#/$defs/idPath"}},
    "checks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "title", "verdicts"],
        "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/text"}, "verdicts": {"type": "array", "minItems": 1, "items": {"enum": ["pass", "fail", "blocked"]}}}
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "kind", "title"],
        "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["question", "approval", "escalation", "interview_round"]}, "title": {"$ref": "#/$defs/text"}}
      }
    },
    "mcp_servers": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "transport", "optional", "purpose"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "plugin": {"$ref": "#/$defs/id"},
          "server": {"$ref": "#/$defs/id"},
          "transport": {"enum": ["stdio", "http"]},
          "url": {"type": "string", "pattern": "^http://(127\\.0\\.0\\.1|localhost):[0-9]{2,5}/[A-Za-z0-9/_-]*$"},
          "optional": {"type": "boolean"},
          "purpose": {"$ref": "#/$defs/text"}
        }
      }
    },
    "hooks": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "plugin", "event", "command", "optional", "purpose"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "plugin": {"$ref": "#/$defs/id"},
          "event": {"enum": ["SessionStart", "SessionEnd", "PreToolUse", "PostToolUse", "UserPromptSubmit", "Stop", "SubagentStop", "PreCompact", "Notification"]},
          "command": {"$ref": "#/$defs/path"},
          "optional": {"type": "boolean"},
          "purpose": {"$ref": "#/$defs/text"}
        }
      }
    },
    "ui": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "phases": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "title"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "title": {"$ref": "#/$defs/text"}}}},
        "artifacts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["glob", "renderer"], "properties": {"glob": {"type": "string", "maxLength": 256}, "renderer": {"enum": ["markdown", "json", "table", "image", "text"]}}}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "idList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "text": {"type": "string", "minLength": 1, "maxLength": 300},
    "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))(?!.*\\\\)[^\\u0000-\\u001f]+$"},
    "idPath": {"type": "object", "additionalProperties": false, "required": ["id", "path"], "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/path"}}},
    "harness": {"enum": ["claude-code", "codex", "opencode", "acp"]},
    "capability": {"enum": ["resume", "native_questions", "subagents", "skills", "mcp", "hooks", "plugins", "structured_protocol"]}
  }
}
