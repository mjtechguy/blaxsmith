{
  "schema_version": "blaxsmith.recipe/v1alpha1",
  "name": "anvil-starter",
  "profiles": {
    "implementer": {
      "harness": "codex",
      "model": "gpt-5.6-luna",
      "effort": "xhigh"
    }
  },
  "stages": [
    {
      "id": "implement",
      "kind": "implement",
      "profile": "implementer",
      "prompt": "examples/anvil/implement.md"
