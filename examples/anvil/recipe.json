      ]
    }
  ],
  "required_checks": [],
  "limits": {
    "max_correction_cycles": 3,
    "timeout_seconds": 1800,
    "max_runtime_seconds": 0
  },
  "acceptance": "manual",
  "factory": {
    "id": "anvil",
    "version": "0.1.0"
  }
}
