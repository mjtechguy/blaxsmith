+package ingress
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	corev3 "github.com/envoyproxy/go-control-plane/envoy/config/core/v3"
+	"google.golang.org/grpc"
+	"google.golang.org/protobuf/types/known/structpb"
+
+	"github.com/agent-substrate/substrate/cmd/atenet/internal/router/extproc"
+	"github.com/agent-substrate/substrate/pkg/proto/ateapipb"
+)
+
+func TestBootstrapRouteRequiresConnectorAndStripsToken(t *testing.T) {
+	resumes := 0
+	h := New(&mockClient{resumeFn: func(context.Context, *ateapipb.ResumeActorRequest, ...grpc.CallOption) (*ateapipb.ResumeActorResponse, error) {
+		resumes++
+		return &ateapipb.ResumeActorResponse{Actor: &ateapipb.Actor{Status: &ateapipb.ActorStatus{
+			WorkerAssignment: &ateapipb.WorkerAssignment{WorkerPodIp: "10.0.0.52"},
+		}}}, nil
+	}}, ParkedRequestConfig{}, nil)
+	seen := ""
+	h.RequireBootstrapAuth(func(_ context.Context, token string) (bool, error) {
+		seen = token
+		return token == "good", nil
+	})
+	request := func(path, auth string) (*extproc.Result, error) {
+		md := requestMetadata("actor-1", "team-a",
+			&corev3.HeaderValue{Key: ":path", Value: path},
+			&corev3.HeaderValue{Key: ":method", Value: "GET"},
+			&corev3.HeaderValue{Key: "Authorization", Value: auth},
+		)
+		md.Attributes = map[string]*structpb.Struct{"envoy.filters.http.ext_proc": {
+			Fields: map[string]*structpb.Value{"connection.tls_version": structpb.NewStringValue("TLSv1.3")},
+		}}
+		result, err := h.HandleRequestHeaders(context.Background(), md)
+		return &result, err
+	}
+	withoutTLS := requestMetadata("actor-1", "team-a",
+		&corev3.HeaderValue{Key: ":path", Value: "/blaxsmith/bootstrap/challenge"},
+		&corev3.HeaderValue{Key: ":method", Value: "GET"},
+		&corev3.HeaderValue{Key: "Authorization", Value: "Bearer good"},
+		&corev3.HeaderValue{Key: "x-forwarded-proto", Value: "https"},
+	)
+	if _, err := h.HandleRequestHeaders(context.Background(), withoutTLS); err == nil {
+		t.Fatal("plaintext client spoofed TLS using a header")
+	}
+	for _, auth := range []string{"", "Basic good", "Bearer bad"} {
+		if _, err := request("/blaxsmith/bootstrap/challenge", auth); err == nil {
+			t.Fatalf("bootstrap accepted %q", auth)
+		}
+	}
+	if resumes != 0 {
+		t.Fatal("unauthorized bootstrap resumed the actor")
+	}
+	for _, path := range []string{"/blaxsmith/bootstrap/challenge", "/%62laxsmith/bootstrap/challenge?x=1"} {
+		result, err := request(path, "Bearer good")
+		if err != nil || seen != "good" || resumes == 0 {
+			t.Fatalf("authorized bootstrap = %v, seen %q", err, seen)
+		}
+		removed := result.Response.GetResponse().GetHeaderMutation().GetRemoveHeaders()
+		if len(removed) != 1 || removed[0] != "authorization" {
+			t.Fatalf("connector token forwarded: removed headers %v", removed)
+		}
+	}
+	h.RequireBootstrapAuth(func(context.Context, string) (bool, error) { return false, errors.New("apiserver unavailable") })
+	if _, err := request("/blaxsmith/bootstrap/challenge", "Bearer good"); err == nil {
+		t.Fatal("TokenReview outage allowed bootstrap")
+	}
+}
