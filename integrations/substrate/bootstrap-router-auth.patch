 func (h *Handler) HandleRequestHeaders(ctx context.Context, md *extproc.RequestMetadata) (extproc.Result, error) {
 	slog.InfoContext(ctx, "Request", slog.String("host", md.Host))
+	bootstrap, err := isBootstrapPath(md.Path)
+	if err != nil {
+		return extproc.Result{}, extproc.NewReqError(envoy_type.StatusCode_BadRequest, "invalid request path")
+	}
+	if bootstrap {
+		if md.Attribute("connection.tls_version") == "" {
+			return extproc.Result{}, extproc.NewReqError(envoy_type.StatusCode_UpgradeRequired, "bootstrap requires TLS")
+		}
+		if md.Method != http.MethodGet && md.Method != http.MethodPost {
+			return extproc.Result{}, extproc.NewReqError(envoy_type.StatusCode_MethodNotAllowed, "bootstrap method denied")
+		}
+		scheme, token, ok := strings.Cut(md.Header("authorization"), " ")
+		if !ok || !strings.EqualFold(scheme, "Bearer") || token == "" || len(token) > 16384 || strings.ContainsAny(token, " \t\r\n") {
+			return extproc.Result{}, extproc.NewReqError(envoy_type.StatusCode_Unauthorized, "bootstrap authentication required")
+		}
+		if h.bootstrapAuth == nil {
+			return extproc.Result{}, extproc.NewReqError(envoy_type.StatusCode_ServiceUnavailable, "bootstrap authentication unavailable")
+		}
+		allowed, err := h.bootstrapAuth(ctx, token)
+		if err != nil {
+			return extproc.Result{}, extproc.NewReqError(envoy_type.StatusCode_ServiceUnavailable, "bootstrap authentication unavailable")
+		}
+		if !allowed {
+			return extproc.Result{}, extproc.NewReqError(envoy_type.StatusCode_Forbidden, "bootstrap identity denied")
+		}
+	}
 
