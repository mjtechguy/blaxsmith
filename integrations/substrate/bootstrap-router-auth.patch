+func isBootstrapPath(raw string) (bool, error) {
+	if raw == "" { // CONNECT authority is not a request path.
+		return false, nil
+	}
+	u, err := url.ParseRequestURI(raw)
+	if err != nil {
+		return false, err
+	}
+	return strings.HasPrefix(path.Clean(u.Path), "/blaxsmith/bootstrap/"), nil
+}
