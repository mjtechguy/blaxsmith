+package router
+
+import (
+	"context"
+	"testing"
+
+	authenticationv1 "k8s.io/api/authentication/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/client-go/kubernetes/fake"
+	ktesting "k8s.io/client-go/testing"
+)
+
+func TestReviewBootstrapTokenChecksAudienceAndPrincipal(t *testing.T) {
+	client := fake.NewSimpleClientset()
+	var status authenticationv1.TokenReviewStatus
+	client.PrependReactor("create", "tokenreviews", func(action ktesting.Action) (bool, runtime.Object, error) {
+		review := action.(ktesting.CreateAction).GetObject().(*authenticationv1.TokenReview)
+		if review.Spec.Token != "token" || len(review.Spec.Audiences) != 1 || review.Spec.Audiences[0] != "blaxsmith-bootstrap" {
+			t.Fatal("TokenReview did not bind the expected token and audience")
+		}
+		return true, &authenticationv1.TokenReview{Status: status}, nil
+	})
+	check := func(want bool) {
+		t.Helper()
+		got, err := reviewBootstrapToken(context.Background(), client, "blaxsmith-bootstrap",
+			"system:serviceaccount:ate-system:blaxsmith-connector", "token")
+		if err != nil || got != want {
+			t.Fatalf("review result = %v, %v; want %v", got, err, want)
+		}
+	}
+	status = authenticationv1.TokenReviewStatus{Authenticated: true,
+		Audiences: []string{"blaxsmith-bootstrap"},
+		User:      authenticationv1.UserInfo{Username: "system:serviceaccount:ate-system:blaxsmith-connector"}}
+	check(true)
+	status.User.Username = "system:serviceaccount:ate-system:other"
+	check(false)
+	status.User.Username = "system:serviceaccount:ate-system:blaxsmith-connector"
+	status.Audiences = []string{"another-audience"}
+	check(false)
+	status.Authenticated = false
+	check(false)
+}
