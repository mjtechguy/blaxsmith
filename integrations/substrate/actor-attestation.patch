+
+// ActorIdentity identifies the activation whose key and certificate this source owns.
+func (s *BrokerCertificateSource) ActorIdentity() (string, string, string) {
+	return s.actorAtespace, s.actorName, s.actorUID
+}
+
+// SignBootstrapProof binds a connector nonce and guest response to the current
+// actor certificate. The private key stays in atunnel; no credential is sent
+// into the guest or embedded in the signed response.
+func (s *BrokerCertificateSource) SignBootstrapProof(nonce, body []byte) ([]byte, []byte, error) {
+	cert, err := s.GetClientCertificate(nil)
+	if err != nil {
+		return nil, nil, err
+	}
+	h := sha256.New()
+	h.Write([]byte("blaxsmith/actor-proof/v1\x00"))
+	h.Write(nonce)
+	h.Write(body)
+	signature, err := ecdsa.SignASN1(rand.Reader, s.privateKey, h.Sum(nil))
+	if err != nil {
+		return nil, nil, fmt.Errorf("atunnel: sign bootstrap proof: %w", err)
+	}
+	var chain []byte
+	for _, der := range cert.Certificate {
+		chain = append(chain, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})...)
+	}
+	return chain, signature, nil
+}
