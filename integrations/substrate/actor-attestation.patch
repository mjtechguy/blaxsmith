+	"net/url"
+	"testing"
+	"time"
+
+	"github.com/agent-substrate/substrate/internal/atenet"
+)
+
+type testBootstrapAttestor struct {
+	nonce, body []byte
+}
+
+func (*testBootstrapAttestor) ActorIdentity() (string, string, string) {
+	return "team-a", "actor-1", "uid-1"
+}
+
+func (a *testBootstrapAttestor) SignBootstrapProof(nonce, body []byte) ([]byte, []byte, error) {
+	a.nonce, a.body = bytes.Clone(nonce), bytes.Clone(body)
+	return []byte("certificate"), []byte("signature"), nil
+}
+
+func TestBootstrapProofRoutesOnlyCurrentActor(t *testing.T) {
+	guest := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != bootstrapChallengePath || r.Header.Get(BootstrapChallengeHeader) != "" {
+			t.Errorf("unexpected guest request: %s %s", r.Method, r.URL.Path)
+		}
+		_, _ = w.Write([]byte(`{"nonce":"guest","expires_at":123,"atespace":"team-a","task":"actor-1"}`))
+	}))
+	defer guest.Close()
+	upstream, _ := url.Parse(guest.URL)
+	s := newTestServer(t, upstream)
+	attestor := &testBootstrapAttestor{}
+	if err := s.ActivateAttested("team-a", "actor-1", attestor); err != nil {
+		t.Fatal(err)
+	}
+	defer s.Deactivate(context.Background())
+	var nonce [32]byte
+	if _, err := rand.Read(nonce[:]); err != nil {
+		t.Fatal(err)
+	}
+	request := func(actor, challenge string) *httptest.ResponseRecorder {
+		r := httptest.NewRequest(http.MethodGet, "https://worker"+bootstrapChallengePath, nil)
+		r.Header.Set(atenet.TargetActorHeader, actor)
+		r.Header.Set(BootstrapChallengeHeader, challenge)
+		w := httptest.NewRecorder()
+		s.ServeHTTP(w, r)
+		return w
+	}
+	validNonce := base64.RawURLEncoding.EncodeToString(nonce[:])
+	if got := request("team-a/other", validNonce).Code; got != http.StatusMisdirectedRequest {
+		t.Fatalf("wrong actor status = %d", got)
+	}
+	if got := request("team-a/actor-1", "bad").Code; got != http.StatusBadRequest {
+		t.Fatalf("malformed nonce status = %d", got)
+	}
+	response := request("team-a/actor-1", validNonce)
+	if response.Code != http.StatusOK || !bytes.Equal(attestor.nonce, nonce[:]) || !bytes.Equal(attestor.body, response.Body.Bytes()) {
+		t.Fatalf("proof response = %d, nonce/body mismatch", response.Code)
+	}
+	if response.Header().Get(BootstrapCertificateHeader) != base64.StdEncoding.EncodeToString([]byte("certificate")) ||
+		response.Header().Get(BootstrapSignatureHeader) != base64.StdEncoding.EncodeToString([]byte("signature")) {
+		t.Fatal("signed proof headers missing")
+	}
+}
+
+func TestBootstrapSourceSignsCurrentCertificate(t *testing.T) {
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now()
+	template := &x509.Certificate{SerialNumber: big.NewInt(1), NotBefore: now.Add(-time.Minute), NotAfter: now.Add(time.Hour)}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	leaf, err := x509.ParseCertificate(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+	source := &BrokerCertificateSource{
+		privateKey:  key,
+		certificate: &tls.Certificate{Certificate: [][]byte{der}, PrivateKey: key, Leaf: leaf},
+	}
+	nonce := bytes.Repeat([]byte{7}, 32)
+	body := []byte(`{"nonce":"guest"}`)
+	chain, signature, err := source.SignBootstrapProof(nonce, body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	block, _ := pem.Decode(chain)
+	if block == nil || !bytes.Equal(block.Bytes, der) {
+		t.Fatal("proof did not carry current certificate")
+	}
+	hash := sha256.Sum256(append(append([]byte("blaxsmith/actor-proof/v1\x00"), nonce...), body...))
+	if !ecdsa.VerifyASN1(&key.PublicKey, hash[:], signature) {
+		t.Fatal("proof signature invalid")
+	}
+	_, otherSignature, err := source.SignBootstrapProof(nonce, []byte("different"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if ecdsa.VerifyASN1(&key.PublicKey, hash[:], otherSignature) {
+		t.Fatal("proof did not bind the guest response")
+	}
+}
