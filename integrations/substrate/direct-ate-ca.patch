+func TestServerTLSConfigFromCAFileAvoidsKubeconfig(t *testing.T) {
+	caFile := filepath.Join(t.TempDir(), "ate-api-ca.pem")
+	if err := os.WriteFile(caFile, testCAPEM(t, "ate-api-ca"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("KUBECTL_ATE_CA_FILE", caFile)
+	tokenFile := filepath.Join(t.TempDir(), "token")
+	if err := os.WriteFile(tokenFile, []byte("synthetic-token\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	client, err := NewClient(context.Background(), filepath.Join(t.TempDir(), "missing-kubeconfig"), "",
+		"127.0.0.1:443", tokenFile, false)
+	if err != nil {
+		t.Fatalf("NewClient with explicit CA/token and absent kubeconfig: %v", err)
+	}
+	client.Close()
+}
+
+func TestServerTLSConfigFromCAFileRequiresExplicitToken(t *testing.T) {
+	caFile := filepath.Join(t.TempDir(), "ate-api-ca.pem")
+	if err := os.WriteFile(caFile, testCAPEM(t, "ate-api-ca"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("KUBECTL_ATE_CA_FILE", caFile)
+	if _, err := NewClient(context.Background(), "", "", "127.0.0.1:443", "", false); err == nil {
+		t.Fatal("NewClient with explicit CA and implicit token succeeded")
+	}
+}
