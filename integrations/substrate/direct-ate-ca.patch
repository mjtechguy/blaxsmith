+
+// serverTLSConfigFromCAFile supports in-cluster clients that receive the
+// pinned ate-api trust bundle as configuration and have no Kubernetes API
+// permissions. The explicit bearer token is still sent only after TLS
+// hostname and CA validation.
+func serverTLSConfigFromCAFile(path string) (*tls.Config, error) {
+	if path == "" {
+		return nil, fmt.Errorf("CA file is required")
+	}
+	caPEM, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("reading ate-api CA file: %w", err)
+	}
+	pool := x509.NewCertPool()
+	if !pool.AppendCertsFromPEM(caPEM) {
+		return nil, fmt.Errorf("ate-api CA file %q contains no valid certificates", path)
+	}
+	return serverTLSConfigFromPool(pool)
+}
+
+func serverTLSConfigFromPool(pool *x509.CertPool) (*tls.Config, error) {
+	if pool == nil {
+		return nil, fmt.Errorf("ate-api trust pool is required")
+	}
+	return &tls.Config{MinVersion: tls.VersionTLS13, RootCAs: pool, ServerName: apiServerName}, nil
 }
 
