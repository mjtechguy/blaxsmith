+
+// authorizeDestination checks the current policy for each new CONNECT. The
+// tunnel carries an original destination IP, not a trustworthy DNS name, so
+// hostname rules cannot be enforced here and fail closed.
+func (h *Handler) authorizeDestination(ctx context.Context, identity *substratex509.ActorIdentity, destination string) error {
+	addrPort, err := netip.ParseAddrPort(destination)
+	if err != nil || addrPort.Port() == 0 || addrPort.Addr().Zone() != "" {
+		return extproc.NewReqError(envoy_type.StatusCode_Forbidden,
+			"egress denied: invalid IP destination %q", destination)
+	}
+	addr := addrPort.Addr().Unmap()
+	policy, err := h.apiClient.GetActorEgressPolicy(ctx, &ateapipb.GetActorEgressPolicyRequest{
+		Actor: &ateapipb.ObjectRef{Atespace: identity.Atespace, Name: identity.ActorName},
+	})
+	if err != nil {
+		return mapEgressIdentityError(identity.Atespace, identity.ActorName, err)
+	}
+	if policy == nil || policy.GetMetadata().GetAtespace() != identity.Atespace || policy.GetMetadata().GetName() != "default" {
+		return extproc.NewReqError(envoy_type.StatusCode_ServiceUnavailable,
+			"egress unavailable: invalid policy for %q/%q", identity.Atespace, identity.ActorName)
+	}
+
+	allowed := false
+	for _, rule := range policy.GetRules() {
+		if rule == nil || rule.GetHostnames() != nil || (rule.GetAll() == nil && rule.GetCidrs() == nil) ||
+			(rule.GetAll() != nil && rule.GetCidrs() != nil) {
+			return extproc.NewReqError(envoy_type.StatusCode_ServiceUnavailable,
+				"egress unavailable: unsupported policy rule for %q/%q", identity.Atespace, identity.ActorName)
+		}
+		if rule.GetAll() != nil {
+			allowed = true
+		}
+		if rule.GetCidrs() != nil {
+			for _, cidr := range rule.GetCidrs().GetCidrs() {
+				prefix, err := netip.ParsePrefix(cidr)
+				if err != nil || prefix.Masked() != prefix || prefix.Addr().Is4In6() {
+					return extproc.NewReqError(envoy_type.StatusCode_ServiceUnavailable,
+						"egress unavailable: invalid policy CIDR for %q/%q", identity.Atespace, identity.ActorName)
+				}
+				if prefix.Contains(addr) {
+					allowed = true
+				}
+			}
+		}
+	}
+	if !allowed {
+		return extproc.NewReqError(envoy_type.StatusCode_Forbidden,
+			"egress denied: destination %q is not allowed", destination)
+	}
+	return nil
 }
 
