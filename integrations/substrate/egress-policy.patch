+func TestHandleRequestHeadersEnforcesEgressPolicy(t *testing.T) {
+	ca := newTestCA(t, "actor-identity-ca")
+	leaf := ca.issueActorCert(t, actorCertOptions{})
+	metadata := func(destination string) *extproc.RequestMetadata {
+		md := egressMetadata(xfccHeader(leaf))
+		md.Host = destination
+		md.Headers[":authority"] = destination
+		return md
+	}
+	policy := func(rules ...*ateapipb.EgressRule) *ateapipb.EgressPolicy {
+		return &ateapipb.EgressPolicy{
+			Metadata: &ateapipb.ResourceMetadata{Atespace: testEgressAtespace, Name: "default"},
+			Rules:    rules,
+		}
+	}
+	cidr := func(prefixes ...string) *ateapipb.EgressRule {
+		return &ateapipb.EgressRule{Cidrs: &ateapipb.CIDRRule{Cidrs: prefixes}}
+	}
+	tests := []struct {
+		name        string
+		policy      *ateapipb.EgressPolicy
+		policyErr   error
+		destination string
+		want        envoy_type.StatusCode
+	}{
+		{"empty policy denies", policy(), nil, "93.184.216.34:80", envoy_type.StatusCode_Forbidden},
+		{"matching IPv4 CIDR allows", policy(cidr("93.184.216.0/24")), nil, "93.184.216.34:80", 0},
+		{"unmatched IPv4 CIDR denies", policy(cidr("192.0.2.0/24")), nil, "93.184.216.34:80", envoy_type.StatusCode_Forbidden},
+		{"matching IPv6 CIDR allows", policy(cidr("2001:db8::/32")), nil, "[2001:db8::1]:443", 0},
+		{"missing policy denies", nil, status.Error(codes.NotFound, "missing"), "93.184.216.34:80", envoy_type.StatusCode_Forbidden},
+		{"unavailable policy denies", nil, status.Error(codes.Unavailable, "down"), "93.184.216.34:80", envoy_type.StatusCode_ServiceUnavailable},
+		{"hostname policy unsupported", policy(&ateapipb.EgressRule{Hostnames: &ateapipb.HostnameRule{Patterns: []string{"example.com"}}}), nil, "93.184.216.34:80", envoy_type.StatusCode_ServiceUnavailable},
+		{"hostname rule after all still blocks", policy(&ateapipb.EgressRule{All: &emptypb.Empty{}}, &ateapipb.EgressRule{Hostnames: &ateapipb.HostnameRule{Patterns: []string{"example.com"}}}), nil, "93.184.216.34:80", envoy_type.StatusCode_ServiceUnavailable},
+		{"malformed CIDR blocks", policy(cidr("93.184.216.34/24")), nil, "93.184.216.34:80", envoy_type.StatusCode_ServiceUnavailable},
+		{"hostname destination blocks", policy(&ateapipb.EgressRule{All: &emptypb.Empty{}}), nil, "example.com:443", envoy_type.StatusCode_Forbidden},
+		{"zero port blocks", policy(&ateapipb.EgressRule{All: &emptypb.Empty{}}), nil, "93.184.216.34:0", envoy_type.StatusCode_Forbidden},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			client := &egressMockClient{actor: runningActor(), policy: tc.policy, policyErr: tc.policyErr}
+			h := New(client, ca.roots())
+			_, err := h.HandleRequestHeaders(context.Background(), metadata(tc.destination))
+			if tc.want == 0 {
+				if err != nil {
+					t.Fatalf("HandleRequestHeaders() error = %v, want nil", err)
+				}
+			} else {
+				wantStatus(t, err, tc.want)
+			}
+		})
 	}
 }
 
