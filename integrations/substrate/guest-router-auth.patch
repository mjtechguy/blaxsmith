+func TestGuestRouteRequiresConnectorWhenEnabled(t *testing.T) {
+	resumes := 0
+	h := New(&mockClient{resumeFn: func(context.Context, *ateapipb.ResumeActorRequest, ...grpc.CallOption) (*ateapipb.ResumeActorResponse, error) {
+		resumes++
+		return &ateapipb.ResumeActorResponse{Actor: &ateapipb.Actor{Metadata: &ateapipb.ResourceMetadata{Uid: "uid-1"}, Status: &ateapipb.ActorStatus{
+			WorkerAssignment: &ateapipb.WorkerAssignment{WorkerPodIp: "10.0.0.52"},
+		}}}, nil
+	}}, ParkedRequestConfig{}, nil)
+	h.RequireBootstrapAuth(func(_ context.Context, token string) (bool, error) { return token == "good", nil })
+	request := func(path, auth string, tls bool) (*extproc.Result, error) {
+		md := requestMetadata("actor-1", "team-a",
+			&corev3.HeaderValue{Key: ":path", Value: path},
+			&corev3.HeaderValue{Key: ":method", Value: "POST"},
+			&corev3.HeaderValue{Key: "content-type", Value: "application/grpc"},
+			&corev3.HeaderValue{Key: "Authorization", Value: auth},
+		)
+		if tls {
+			md.Attributes = map[string]*structpb.Struct{"envoy.filters.http.ext_proc": {
+				Fields: map[string]*structpb.Value{"connection.tls_version": structpb.NewStringValue("TLSv1.3")},
+			}}
+		}
+		result, err := h.HandleRequestHeaders(context.Background(), md)
+		return &result, err
+	}
+	const exec = "/ateenv.v1alpha.ProcessService/StartProcess"
+	if _, err := request(exec, "", false); err != nil {
+		t.Fatalf("guest route closed without --guest-client-auth: %v", err)
+	}
+	h.RequireGuestAuth(func(_ context.Context, token string) (bool, error) { return token == "guest", nil })
+	resumes = 0
+	for _, p := range []string{exec, "/%61teenv.v1alpha.FileSystemService/ReadFile", "/x/../ateenv.v1alpha.EnvironmentService/Get"} {
+		// "good" is the bootstrap connector's token: its own identity only.
+		for _, auth := range []string{"", "Basic guest", "Bearer bad", "Bearer good"} {
+			if _, err := request(p, auth, true); err == nil {
+				t.Fatalf("guest route %s accepted %q", p, auth)
+			}
+		}
+		if _, err := request(p, "Bearer guest", false); err == nil {
+			t.Fatalf("plaintext guest route %s accepted", p)
+		}
+	}
+	if resumes != 0 {
+		t.Fatal("unauthenticated guest call resumed the actor")
+	}
+	if _, err := request("/blaxsmith/bootstrap/challenge", "Bearer guest", true); err == nil {
+		t.Fatal("guest identity accepted on a bootstrap route")
+	}
+	result, err := request(exec, "Bearer guest", true)
+	if err != nil || resumes != 1 {
+		t.Fatalf("authorized guest call = %v", err)
+	}
+	removed := result.Response.GetResponse().GetHeaderMutation().GetRemoveHeaders()
+	if len(removed) != 1 || removed[0] != "authorization" {
+		t.Fatalf("connector token forwarded to guest: removed headers %v", removed)
+	}
+	if _, err := request("/readyz?check=workspace", "", false); err != nil {
+		t.Fatalf("non-guest route now needs auth: %v", err)
+	}
+}
