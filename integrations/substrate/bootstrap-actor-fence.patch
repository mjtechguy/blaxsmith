+		t.Fatal(err)
+	}
+	defer s.Deactivate(context.Background())
+	for _, uid := range []string{"", "old-uid", "uid-1"} {
+		r := httptest.NewRequest(http.MethodPost, "https://worker/blaxsmith/bootstrap/release", nil)
+		r.Header.Set(atenet.TargetActorHeader, "team-a/actor-1")
+		r.Header.Set(BootstrapActorUIDHeader, uid)
+		w := httptest.NewRecorder()
+		s.ServeHTTP(w, r)
+		if uid == "uid-1" && w.Code != http.StatusNoContent {
+			t.Fatalf("current actor release status = %d", w.Code)
+		}
+		if uid != "uid-1" && w.Code != http.StatusMisdirectedRequest {
+			t.Fatalf("stale actor release status = %d", w.Code)
+		}
+	}
