index 0000000..ab48c72
--- /dev/null
+++ b/runner/model_credential_test.go
@@ -0,0 +1,64 @@
+package runner
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/google/ax/pkg/apis/v1alpha1"
+)
+
+func TestModelCredentialNeedsMatchingPinnedCommandAndPrivateFile(t *testing.T) {
+	command := []string{"/usr/local/bin/blaxsmith-tool-worker", `{"attempt_id":"attempt-a","profile":{"harness":"codex","model":"gpt-6-luna"}}`}
+	payload := func(attempt, provider string) []byte {
+		t.Helper()
+		body, _ := json.Marshal(map[string]any{"kind": "model_api_key", "attempt_id": attempt,
+			"provider": provider, "expires_at": time.Now().Add(10 * time.Minute).Unix(), "api_key": "private-key"})
+		return body
+	}
+	git, data, err := decodeBootstrapPayload(payload("attempt-a", "openai"), nil, command)
+	if err != nil || git != nil || strings.Contains(string(data), `"kind"`) || !strings.Contains(string(data), "private-key") {
+		t.Fatalf("model payload decode: git=%v data=%q err=%v", git, data, err)
+	}
+	for _, candidate := range [][]string{{"/bin/sh", "-c", "true"}, {command[0], `{"attempt_id":"other","profile":{"harness":"codex","model":"gpt-6-luna"}}`}} {
+		if _, _, err := decodeBootstrapPayload(payload("attempt-a", "openai"), nil, candidate); err == nil {
+			t.Fatalf("mismatched command accepted: %q", candidate)
+		}
+	}
+	if _, _, err := decodeBootstrapPayload(payload("attempt-a", "anthropic"), nil, command); err == nil {
+		t.Fatal("wrong provider accepted")
+	}
+	ws := &v1alpha1.Workspace{Spec: &v1alpha1.WorkspaceSpec{Git: []*v1alpha1.GitRepo{{
+		Repo: "https://github.com/owner/repo.git", Branch: "main",
+	}}}}
+	bundle, err := json.Marshal(map[string]any{"schema": "blaxsmith.bootstrap-capabilities/v1alpha1",
+		"attempt_id": "attempt-a", "git": map[string]string{"repo_url": "https://github.com/owner/repo.git",
+			"commit": strings.Repeat("a", 40), "username": "blaxsmith", "token": "private-git-token"},
+		"model": json.RawMessage(payload("attempt-a", "openai"))})
+	if err != nil {
+		t.Fatal(err)
+	}
+	git, data, err = decodeBootstrapPayload(bundle, []*v1alpha1.Workspace{ws}, command)
+	if err != nil || git == nil || git.RepoURL != "https://github.com/owner/repo.git" ||
+		!strings.Contains(string(data), "private-key") {
+		t.Fatalf("combined capabilities: git=%+v model=%q err=%v", git, data, err)
+	}
+	root := t.TempDir()
+	if err := os.Chmod(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(root, "agent-credential.json")
+	if err := writeModelCredential(path, data); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Lstat(path)
+	if err != nil || info.Mode().Perm() != 0600 {
+		t.Fatalf("credential file mode: %v %v", info, err)
+	}
+	if err := writeModelCredential(path, data); err == nil {
+		t.Fatal("existing credential file was replaced")
+	}
+}
