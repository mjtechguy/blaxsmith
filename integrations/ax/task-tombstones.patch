+func TestDeletedTaskNameCannotBeReused(t *testing.T) {
+	ctx := t.Context()
+	memStore := memory.NewStore()
+	srv := server.NewServer(memStore)
+	if _, err := srv.DeleteTask(ctx, &v1alpha1.DeleteTaskRequest{Name: "attempt-unseen"}); status.Code(err) != codes.NotFound {
+		t.Fatalf("deleting an unseen attempt: %v", err)
+	}
+	if _, err := srv.UpdateTask(ctx, &v1alpha1.UpdateTaskRequest{Task: &v1alpha1.Task{
+		Metadata: &v1alpha1.ObjectMeta{Name: "attempt-unseen"}, Spec: &v1alpha1.TaskSpec{Image: "alpine"},
+	}}); status.Code(err) != codes.FailedPrecondition {
+		t.Fatalf("late initial upsert after absent delete: %v", err)
+	}
+	task := &v1alpha1.Task{Metadata: &v1alpha1.ObjectMeta{Name: "attempt-old"}, Spec: &v1alpha1.TaskSpec{Image: "alpine"}}
+	if _, err := srv.UpdateTask(ctx, &v1alpha1.UpdateTaskRequest{Task: task}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := srv.DeleteTask(ctx, &v1alpha1.DeleteTaskRequest{Name: "attempt-old"}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := srv.UpdateTask(ctx, &v1alpha1.UpdateTaskRequest{Task: task}); status.Code(err) != codes.FailedPrecondition {
+		t.Fatalf("update after cancellation: %v", err)
+	}
+	if err := memStore.DeleteTask(ctx, "default", "attempt-old"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := srv.UpdateTask(ctx, &v1alpha1.UpdateTaskRequest{Task: task}); status.Code(err) != codes.FailedPrecondition {
+		t.Fatalf("late update resurrected deleted task: %v", err)
+	}
+	task.Metadata.Name = "attempt-new"
+	if _, err := srv.UpdateTask(ctx, &v1alpha1.UpdateTaskRequest{Task: task}); err != nil {
+		t.Fatalf("new attempt name rejected: %v", err)
+	}
+}
