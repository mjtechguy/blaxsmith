+package workspace
+
+import (
+	"bytes"
+	"context"
+	"encoding/pem"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/google/ax/pkg/apis/v1alpha1"
+)
+
+func TestGitCredentialOnlyOnMatchingFetch(t *testing.T) {
+	const token = "synthetic-private-token"
+	root := t.TempDir()
+	source := filepath.Join(root, "source")
+	bare := filepath.Join(root, "private.git")
+	if err := os.Mkdir(source, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	run := func(dir string, args ...string) {
+		t.Helper()
+		cmd := exec.Command("git", args...)
+		cmd.Dir = dir
+		if out, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("git %v: %v: %s", args, err, out)
+		}
+	}
+	run(source, "init")
+	run(source, "symbolic-ref", "HEAD", "refs/heads/main")
+	run(source, "config", "user.email", "test@example.invalid")
+	run(source, "config", "user.name", "Test")
+	if err := os.WriteFile(filepath.Join(source, "README.md"), []byte("private fixture\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	run(source, "add", "README.md")
+	run(source, "commit", "-m", "initial")
+	revision := exec.Command("git", "-C", source, "rev-parse", "HEAD")
+	commitBytes, err := revision.Output()
+	if err != nil {
+		t.Fatal(err)
+	}
+	commit := strings.TrimSpace(string(commitBytes))
+	run(root, "clone", "--bare", source, bare)
+	run(root, "--git-dir", bare, "update-server-info")
+	var seen atomic.Bool
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		user, password, ok := r.BasicAuth()
+		if !ok {
+			w.Header().Set("WWW-Authenticate", `Basic realm="private"`)
+			w.WriteHeader(http.StatusUnauthorized)
+			return
+		}
+		if user == "test-user" && password == token {
+			seen.Store(true)
+			http.StripPrefix("/private.git/", http.FileServer(http.Dir(bare))).ServeHTTP(w, r)
+			return
+		}
+		http.Error(w, "denied", http.StatusForbidden)
+	}))
+	defer server.Close()
+	askpass := filepath.Join(root, "askpass")
+	if err := os.WriteFile(askpass, []byte("#!/bin/sh\ncase \"$1\" in *Username*) printf '%s' \"$BLAXSMITH_GIT_USERNAME\" ;; *Password*) printf '%s' \"$BLAXSMITH_GIT_TOKEN\" ;; esac\n"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	previous := GitAskpassPath
+	GitAskpassPath = askpass
+	defer func() { GitAskpassPath = previous }()
+	caPath := filepath.Join(root, "git-ca.pem")
+	if err := os.WriteFile(caPath, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.Certificate().Raw}), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	previousCA := GitCAFilePath
+	GitCAFilePath = caPath
+	defer func() { GitCAFilePath = previousCA }()
+	credential := &GitCredential{RepoURL: server.URL + "/private.git", Commit: commit, Username: "test-user", Token: []byte(token)}
+	dir := filepath.Join(root, "checkout")
+	if err := os.Mkdir(dir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	output, err := fetchRepo(context.Background(), dir, credential.RepoURL, "main", 0, credential)
+	if err != nil || !seen.Load() {
+		t.Fatalf("Git did not fetch with askpass credential: err=%v seen=%t output=%s", err, seen.Load(), output)
+	}
+	readme, err := os.ReadFile(filepath.Join(dir, "README.md"))
+	if err != nil || string(readme) != "private fixture\n" {
+		t.Fatalf("private checkout missing: %v", err)
+	}
+	config, err := os.ReadFile(filepath.Join(dir, ".git", "config"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Contains(config, []byte(token)) || bytes.Contains(output, []byte(token)) {
+		t.Fatal("token persisted in Git config or diagnostic")
+	}
+	wrongRevision := *credential
+	wrongRevision.Commit = strings.Repeat("0", len(commit))
+	wrongDir := filepath.Join(root, "wrong-revision")
+	if err := os.Mkdir(wrongDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := fetchRepo(context.Background(), wrongDir, credential.RepoURL, "main", 0, &wrongRevision); err == nil {
+		t.Fatal("credentialed fetch accepted a moved or wrong revision")
+	}
+	if _, err := os.Stat(filepath.Join(wrongDir, "README.md")); !os.IsNotExist(err) {
+		t.Fatal("wrong revision reached checkout")
+	}
+	seen.Store(false)
+	withoutCredential := filepath.Join(root, "without-credential")
+	if err := os.Mkdir(withoutCredential, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := fetchRepo(context.Background(), withoutCredential, credential.RepoURL, "main", 0, nil); err == nil || seen.Load() {
+		t.Fatalf("private fetch succeeded without credential or sent authorization: %v, seen=%t", err, seen.Load())
+	}
+	previousAXDir := AXDir
+	AXDir = filepath.Join(root, "ax-ephemeral-1")
+	defer func() { AXDir = previousAXDir }()
+	ws := &v1alpha1.Workspace{Metadata: &v1alpha1.ObjectMeta{Name: "private"},
+		Spec: &v1alpha1.WorkspaceSpec{Git: []*v1alpha1.GitRepo{{Name: "private", Repo: credential.RepoURL, Branch: "main"}}}}
+	workspacePath := filepath.Join(root, "workspace")
+	if _, err := SetupWorkspaceWithGitCredential(context.Background(), ws, workspacePath, "", credential); err != nil {
+		t.Fatalf("initial private workspace: %v", err)
+	}
+	AXDir = filepath.Join(root, "ax-ephemeral-2")
+	resumed, err := SetupWorkspaceWithGitCredential(context.Background(), ws, workspacePath, "", credential)
+	if err != nil || resumed.IsMaidenRun {
+		t.Fatalf("data-snapshot resume repeated checkout: %+v, %v", resumed, err)
+	}
+	wrongResume := *credential
+	wrongResume.Commit = strings.Repeat("0", len(commit))
+	if _, err := SetupWorkspaceWithGitCredential(context.Background(), ws, workspacePath, "", &wrongResume); err == nil {
+		t.Fatal("resumed workspace accepted a different authorized revision")
+	}
+	resumedConfig := filepath.Join(workspacePath, "private", ".git", "config")
+	run(root, "config", "-f", resumedConfig, "remote.origin.url", "https://example.invalid/other.git")
+	if _, err := SetupWorkspaceWithGitCredential(context.Background(), ws, workspacePath, "", credential); err == nil {
+		t.Fatal("changed repository remote accepted on resume")
+	}
+	run(root, "config", "-f", resumedConfig, "remote.origin.url", credential.RepoURL)
+	if err := os.Remove(filepath.Join(workspacePath, ".blaxsmith-initialized")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := SetupWorkspaceWithGitCredential(context.Background(), ws, workspacePath, "", credential); err == nil {
+		t.Fatal("existing Git directory without marker accepted")
+	}
+}
