+package substrate
+
+import (
+	"context"
+	"testing"
+
+	"github.com/agent-substrate/substrate/pkg/proto/ateapipb"
+	"github.com/google/ax/pkg/apis/v1alpha1"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+type policyClient struct {
+	ateapipb.ControlClient
+	create *ateapipb.EgressPolicy
+	update *ateapipb.EgressPolicy
+	exists bool
+}
+
+func (m *policyClient) CreateActorEgressPolicy(_ context.Context, req *ateapipb.CreateActorEgressPolicyRequest, _ ...grpc.CallOption) (*ateapipb.EgressPolicy, error) {
+	m.create = req.EgressPolicy
+	if m.exists {
+		return nil, status.Error(codes.AlreadyExists, "exists")
+	}
+	return req.EgressPolicy, nil
+}
+
+func (m *policyClient) GetActorEgressPolicy(context.Context, *ateapipb.GetActorEgressPolicyRequest, ...grpc.CallOption) (*ateapipb.EgressPolicy, error) {
+	return &ateapipb.EgressPolicy{Metadata: &ateapipb.ResourceMetadata{Uid: "old", Version: 2}}, nil
+}
+
+func (m *policyClient) UpdateActorEgressPolicy(_ context.Context, req *ateapipb.UpdateActorEgressPolicyRequest, _ ...grpc.CallOption) (*ateapipb.EgressPolicy, error) {
+	m.update = req.EgressPolicy
+	return req.EgressPolicy, nil
+}
+
+func TestApplyEgressPolicy(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		hosts     []*v1alpha1.HostRule
+		exists    bool
+		wantRules int
+		wantErr   bool
+	}{
+		{"empty policy is persisted", nil, true, 0, false},
+		{"CIDR is persisted", []*v1alpha1.HostRule{{Host: "192.0.2.0/24"}}, false, 1, false},
+		{"wildcard is persisted", []*v1alpha1.HostRule{{Host: "*"}}, false, 1, false},
+		{"hostname rejected", []*v1alpha1.HostRule{{Host: "example.com"}}, false, 0, true},
+		{"port rejected", []*v1alpha1.HostRule{{Host: "*", Port: 443}}, false, 0, true},
+		{"unsupported rule after wildcard rejected", []*v1alpha1.HostRule{{Host: "*"}, {Host: "example.com"}}, false, 0, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			mock := &policyClient{exists: tc.exists}
+			client := &Client{control: mock}
+			err := client.ApplyEgressPolicy(context.Background(), "default", "actor", &v1alpha1.EgressAllowlist{Hosts: tc.hosts})
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("ApplyEgressPolicy() error = %v, wantErr = %t", err, tc.wantErr)
+			}
+			if tc.wantErr {
+				if mock.create != nil {
+					t.Fatal("unsupported rule reached the control API")
+				}
+				return
+			}
+			policy := mock.create
+			if tc.exists {
+				policy = mock.update
+				if policy == nil || policy.Metadata.Uid != "old" || policy.Metadata.Version != 2 {
+					t.Fatalf("policy update lost resource preconditions: %v", policy)
+				}
+			}
+			if policy == nil || len(policy.Rules) != tc.wantRules {
+				t.Fatalf("policy rules = %v, want %d", policy, tc.wantRules)
+			}
+		})
+	}
+}
