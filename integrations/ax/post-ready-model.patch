+++ b/runner/bootstrap_stage_test.go
@@ -0,0 +1,100 @@
+package runner
+
+import (
+	"crypto/ed25519"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/google/ax/pkg/apis/v1alpha1"
+)
+
+func TestBootstrapGateSeparatesSetupAndModelPhases(t *testing.T) {
+	public, private, err := ed25519.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv(bootstrapKeyEnv, base64.StdEncoding.EncodeToString(public))
+	task := &v1alpha1.Task{Metadata: &v1alpha1.ObjectMeta{Atespace: "space", Name: "task"},
+		Spec: &v1alpha1.TaskSpec{Command: []string{modelWorkerPath, `{"attempt_id":"a","profile":{"harness":"codex","model":"gpt-6-luna"}}`}}}
+	gate, err := newBootstrapGate(task)
+	if err != nil || gate == nil || !gate.requiresModel {
+		t.Fatalf("model bootstrap gate: %+v %v", gate, err)
+	}
+	server := httptest.NewServer(gate)
+	defer server.Close()
+	challenge := func(phase string) map[string]any {
+		t.Helper()
+		response, err := http.Get(server.URL + "/blaxsmith/bootstrap/challenge?phase=" + phase)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer response.Body.Close()
+		if response.StatusCode != http.StatusOK {
+			t.Fatalf("%s challenge status: %d", phase, response.StatusCode)
+		}
+		var body map[string]any
+		if err := json.NewDecoder(response.Body).Decode(&body); err != nil {
+			t.Fatal(err)
+		}
+		if body["phase"] != phase || body["nonce"] == "" {
+			t.Fatalf("invalid %s challenge: %#v", phase, body)
+		}
+		return body
+	}
+	release := func(phase string, challenge map[string]any) int {
+		t.Helper()
+		nonce := challenge["nonce"].(string)
+		expires := int64(challenge["expires_at"].(float64))
+		message := []byte(fmt.Sprintf("blaxsmith/bootstrap/release/v3\n%s\n%s\n%d\nspace\ntask\n", phase, nonce, expires))
+		body, _ := json.Marshal(map[string]any{"phase": phase, "nonce": nonce, "expires_at": expires,
+			"signature": base64.StdEncoding.EncodeToString(ed25519.Sign(private, message))})
+		response, err := http.Post(server.URL+"/blaxsmith/bootstrap/release", "application/json", strings.NewReader(string(body)))
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer response.Body.Close()
+		return response.StatusCode
+	}
+	setup := challenge(setupPhase)
+	if status := challengeStatus(t, server.URL, modelPhase); status != http.StatusConflict {
+		t.Fatalf("model phase opened before setup: %d", status)
+	}
+	if status := release(setupPhase, setup); status != http.StatusNoContent {
+		t.Fatalf("setup release status: %d", status)
+	}
+	if payload, err := gate.takePayload(setupPhase); err != nil || len(payload) != 0 {
+		t.Fatalf("empty public-Git setup payload: %q %v", payload, err)
+	}
+	if status := challengeStatus(t, server.URL, setupPhase); status != http.StatusConflict {
+		t.Fatalf("setup phase replayed: %d", status)
+	}
+	model := challenge(modelPhase)
+	if model["nonce"] == setup["nonce"] {
+		t.Fatal("setup and model phases reused a nonce")
+	}
+	if status := release(setupPhase, model); status != http.StatusForbidden {
+		t.Fatalf("setup signature opened model phase: %d", status)
+	}
+	if status := release(modelPhase, model); status != http.StatusNoContent {
+		t.Fatalf("model release status: %d", status)
+	}
+	if payload, err := gate.takePayload(modelPhase); err != nil || len(payload) != 0 {
+		t.Fatalf("empty model payload: %q %v", payload, err)
+	}
+}
+
+func challengeStatus(t *testing.T, baseURL, phase string) int {
+	t.Helper()
+	response, err := http.Get(baseURL + "/blaxsmith/bootstrap/challenge?phase=" + phase)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	return response.StatusCode
+}
