+// blockExecution prevents activation and attempts to stop any prior execution.
+// Failure to stop stays visible; it is not proof of revoked provider access.
+func (r *TaskReconciler) blockExecution(ctx context.Context, task *v1alpha1.Task, reason string, cause error, now time.Time) (*v1alpha1.Task, error) {
+	stopCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 5*time.Second)
+	defer cancel()
+	stopErr := r.client.SuspendActor(stopCtx, task.Metadata.Atespace, task.Status.Actor)
+	if stopErr == nil || status.Code(stopErr) == codes.NotFound {
+		task.Status.WorkerIp = ""
+	} else {
+		cause = errors.Join(cause, fmt.Errorf("failed to stop existing execution: %w", stopErr))
+	}
+	task.Status.Phase = "Failed"
+	r.setNotReady(task, reason, cause.Error(), now)
+	return task, cause
+}
