+func TestBlaxsmithLaunchBoundaries(t *testing.T) {
+	for _, tc := range []struct {
+		name, reason string
+		server       mockControlServer
+		suspend      bool
+	}{
+		{name: "template failure", reason: "TemplateCreationFailed", server: mockControlServer{templateErr: status.Error(codes.PermissionDenied, "template denied")}},
+		{name: "invalid template", reason: "TemplateCreationFailed", server: mockControlServer{badTemplate: true}},
+		{name: "policy failure", reason: "PolicyApplyFailed", server: mockControlServer{policyErr: status.Error(codes.PermissionDenied, "policy denied")}},
+		{name: "stop failure", reason: "PolicyApplyFailed", server: mockControlServer{policyErr: errors.New("policy denied"), suspendErr: errors.New("stop denied")}},
+		{name: "suspend bypasses broken provisioning", suspend: true, server: mockControlServer{templateErr: errors.New("template denied"), policyErr: errors.New("policy denied")}},
+		{name: "no ambient credential"},
+		{name: "missing gateway", reason: "GatewayUnavailable"},
+		{name: "missing workspace", reason: "WorkspaceUnavailable"},
+		{name: "empty egress allowlist"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("GEMINI_API_KEY", "blaxsmith-synthetic-ambient-key")
+			lis, err := net.Listen("tcp", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			server := grpc.NewServer()
+			ateapipb.RegisterControlServer(server, &tc.server)
+			go server.Serve(lis)
+			defer server.Stop()
+			client, err := substrate.NewClient(lis.Addr().String(), grpc.WithTransportCredentials(insecure.NewCredentials()))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer client.Close()
+			r := controller.NewTaskReconciler(client, "default-template", "ax-system")
+			r.WorkspaceReadyTimeout = time.Millisecond
+			task := &v1alpha1.Task{Metadata: &v1alpha1.ObjectMeta{Name: "boundary", Atespace: "test"}, Spec: &v1alpha1.TaskSpec{Image: "example.invalid/runner", Suspend: tc.suspend}, Status: &v1alpha1.TaskStatus{WorkerIp: "prior-worker"}}
+			var gateway *v1alpha1.Gateway
+			if tc.name == "missing gateway" {
+				task.Spec.Gateway = &v1alpha1.GatewayRef{Name: "missing"}
+			}
+			if tc.name == "missing workspace" {
+				task.Spec.Workspaces = []*v1alpha1.WorkspaceRef{{Name: "missing"}}
+			}
+			if tc.name == "empty egress allowlist" {
+				gateway = &v1alpha1.Gateway{Spec: &v1alpha1.GatewaySpec{Egress: &v1alpha1.EgressConfig{Allowlist: &v1alpha1.EgressAllowlist{}}}}
+			}
+			got, err := r.Reconcile(context.Background(), task, gateway)
+			if tc.name == "empty egress allowlist" && len(tc.server.createdPolicies) != 1 {
+				t.Fatal("empty allowlist did not install a deny policy")
+			}
+			if tc.reason != "" {
+				if err == nil || got.Status.Phase != "Failed" {
+					t.Fatalf("expected blocked execution, got %v / %v", got.Status, err)
+				}
+				assertCondition(t, got, "Ready", "False", tc.reason)
+				if len(tc.server.resumedActors) != 0 {
+					t.Fatal("resumed despite failed prerequisite")
+				}
+				if tc.reason == "TemplateCreationFailed" && len(tc.server.createdActors) != 0 {
+					t.Fatal("fell back to another template")
+				}
+				if tc.server.suspendErr != nil {
+					if !strings.Contains(err.Error(), "failed to stop existing execution") || got.Status.WorkerIp == "" {
+						t.Fatal("stop failure was hidden")
+					}
+				} else if got.Status.WorkerIp != "" {
+					t.Fatal("stale worker remained routable")
+				}
+			} else if err != nil {
+				t.Fatal(err)
+			}
+			if tc.reason != "" || tc.suspend {
