+					t.Fatal("did not attempt to stop execution")
+				}
+			}
+			if tc.suspend && (got.Status.Phase != "Suspended" || tc.server.createdTemplate != nil || len(tc.server.createdPolicies) != 0) {
+				t.Fatal("suspend depended on provisioning")
+			}
+			if tc.server.createdTemplate != nil {
