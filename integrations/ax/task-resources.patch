+// substrateResources maps AX request/limit fields to Substrate's named resource limits.
+func substrateResources(in *v1alpha1.ResourceList) *ateapipb.Resources {
+	if in == nil {
+		return nil
+	}
+	limits := make([]*ateapipb.Limits, 0, 2)
+	if in.GetCpu() != "" {
+		limits = append(limits, &ateapipb.Limits{Name: "cpu", Quantity: in.GetCpu()})
+	}
+	if in.GetMemory() != "" {
+		limits = append(limits, &ateapipb.Limits{Name: "memory", Quantity: in.GetMemory()})
+	}
+	if len(limits) == 0 {
+		return nil
+	}
+	return &ateapipb.Resources{Limits: limits}
+}
