+func TestRedisTLSVerifiesServer(t *testing.T) {
+	redisPath, err := exec.LookPath("redis-server")
+	if err != nil {
+		t.Skip("redis-server is required for TLS test")
+	}
+	dir := t.TempDir()
+	certFile, keyFile := testCertificate(t, dir)
+	port := freePort(t)
+	const password = "test-redis-password"
+	startRedis(t, redisPath, dir, "tls", fmt.Sprintf("port 0\ntls-port %d\ntls-cert-file %s\ntls-key-file %s\ntls-ca-cert-file %s\ntls-auth-clients no\nrequirepass %s\n", port, certFile, keyFile, certFile, password))
+	t.Setenv("REDIS_SENTINEL_MASTER", "")
+	t.Setenv("REDIS_SENTINEL_ADDRS", "")
+	t.Setenv("REDIS_SENTINEL_USERNAME", "")
+	t.Setenv("REDIS_SENTINEL_PASSWORD", "")
+	t.Setenv("REDIS_TLS", "true")
+	t.Setenv("REDIS_TLS_CA_FILE", certFile)
+	t.Setenv("REDIS_TLS_CERT_FILE", "")
+	t.Setenv("REDIS_TLS_KEY_FILE", "")
+	t.Setenv("REDIS_TLS_SERVER_NAME", "")
+	addr := net.JoinHostPort("127.0.0.1", strconv.Itoa(port))
+	client, err := NewClient(addr, password)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	waitFor(t, func() bool { return client.Ping(t.Context()).Err() == nil })
+	if err := client.Set(t.Context(), "tls-probe", "ok", 0).Err(); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("REDIS_TLS_SERVER_NAME", "wrong.example")
+	wrongName, err := NewClient(addr, password)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer wrongName.Close()
+	if err := wrongName.Ping(t.Context()).Err(); err == nil {
+		t.Fatal("TLS accepted wrong server name")
+	}
+}
+
+func TestRedisTLSConfigurationFailsClosed(t *testing.T) {
+	t.Setenv("REDIS_SENTINEL_MASTER", "")
+	t.Setenv("REDIS_SENTINEL_ADDRS", "")
+	t.Setenv("REDIS_SENTINEL_USERNAME", "")
+	t.Setenv("REDIS_SENTINEL_PASSWORD", "")
+	t.Setenv("REDIS_TLS", "false")
+	t.Setenv("REDIS_TLS_CA_FILE", "/missing/ca.pem")
+	if _, err := NewClient("localhost:6379", ""); err == nil {
+		t.Fatal("ignored TLS CA configuration")
+	}
+	t.Setenv("REDIS_TLS", "true")
+	if _, err := NewClient("localhost:6379", ""); err == nil {
+		t.Fatal("accepted unreadable TLS CA")
+	}
+	t.Setenv("REDIS_TLS_CA_FILE", "")
+	config, err := redisTLS()
+	if err != nil || config == nil || config.InsecureSkipVerify || config.MinVersion < 0x0303 {
+		t.Fatalf("TLS verification disabled: %+v, %v", config, err)
+	}
+	t.Setenv("REDIS_SENTINEL_MASTER", "only-master")
+	if _, err := NewClient("localhost:6379", ""); err == nil {
+		t.Fatal("accepted incomplete Sentinel discovery")
+	}
+}
+
+func freePort(t *testing.T) int {
+	t.Helper()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := listener.Addr().(*net.TCPAddr).Port
+	_ = listener.Close()
+	return port
+}
+
+func testCertificate(t *testing.T, dir string) (string, string) {
+	t.Helper()
+	_, key, err := ed25519.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{
+		SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "Redis test"},
+		NotBefore: time.Now().Add(-time.Minute), NotAfter: time.Now().Add(time.Hour),
+		IPAddresses: []net.IP{net.ParseIP("127.0.0.1")},
+		KeyUsage:    x509.KeyUsageDigitalSignature | x509.KeyUsageCertSign,
+		ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+		IsCA:        true, BasicConstraintsValid: true,
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, key.Public(), key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	keyBytes, err := x509.MarshalPKCS8PrivateKey(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	certFile, keyFile := filepath.Join(dir, "cert.pem"), filepath.Join(dir, "key.pem")
+	if err := os.WriteFile(certFile, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(keyFile, pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: keyBytes}), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return certFile, keyFile
+}
+
+func startRedis(t *testing.T, binary, dir, name, extra string) {
+	t.Helper()
+	config := filepath.Join(dir, name+".conf")
+	logfile := filepath.Join(dir, name+".log")
+	contents := fmt.Sprintf("bind 127.0.0.1\nprotected-mode no\nsave \"\"\nappendonly no\ndir %s\nlogfile %s\n%s", dir, logfile, extra)
+	if err := os.WriteFile(config, []byte(contents), 0600); err != nil {
+		t.Fatal(err)
+	}
+	args := []string{config}
+	if name == "sentinel" {
+		args = append(args, "--sentinel")
+	}
+	cmd := exec.Command(binary, args...)
+	cmd.Env = append(os.Environ(), "LC_ALL=C")
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = cmd.Process.Kill(); _ = cmd.Wait() })
+}
+
+func waitFor(t *testing.T, ready func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(15 * time.Second)
+	for time.Now().Before(deadline) {
+		if ready() {
+			return
+		}
+		time.Sleep(100 * time.Millisecond)
+	}
+	t.Fatal("Redis/Sentinel did not reach the expected state")
+}
