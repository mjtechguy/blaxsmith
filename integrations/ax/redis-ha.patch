+func TestSentinelPromotionPreservesTaskTombstone(t *testing.T) {
+	redisPath, err := exec.LookPath("redis-server")
+	if err != nil {
+		t.Skip("redis-server is required for Sentinel failover test")
+	}
+	ctx := t.Context()
+	dir := t.TempDir()
+	masterPort, replicaPort, sentinelPort := freePort(t), freePort(t), freePort(t)
+	masterAddr := net.JoinHostPort("127.0.0.1", strconv.Itoa(masterPort))
+	replicaAddr := net.JoinHostPort("127.0.0.1", strconv.Itoa(replicaPort))
+	sentinelAddr := net.JoinHostPort("127.0.0.1", strconv.Itoa(sentinelPort))
+	const redisPassword, sentinelPassword, masterName = "test-redis-password", "test-sentinel-password", "test-master"
+	startRedis(t, redisPath, dir, "master", fmt.Sprintf("port %d\nrequirepass %s\n", masterPort, redisPassword))
+	master := redis.NewClient(&redis.Options{Addr: masterAddr, Password: redisPassword})
+	defer master.Close()
+	waitFor(t, func() bool { return master.Ping(ctx).Err() == nil })
+	startRedis(t, redisPath, dir, "replica", fmt.Sprintf("port %d\nreplicaof 127.0.0.1 %d\nmasterauth %s\nrequirepass %s\n", replicaPort, masterPort, redisPassword, redisPassword))
+	replica := redis.NewClient(&redis.Options{Addr: replicaAddr, Password: redisPassword})
+	defer replica.Close()
+	waitFor(t, func() bool { return strings.Contains(replica.Info(ctx, "replication").Val(), "master_link_status:up") })
+	startRedis(t, redisPath, dir, "sentinel", fmt.Sprintf("port %d\nrequirepass %s\nsentinel monitor %s 127.0.0.1 %d 1\nsentinel auth-pass %s %s\nsentinel down-after-milliseconds %s 1000\nsentinel failover-timeout %s 5000\n", sentinelPort, sentinelPassword, masterName, masterPort, masterName, redisPassword, masterName, masterName))
+	sentinel := redis.NewSentinelClient(&redis.Options{Addr: sentinelAddr, Password: sentinelPassword})
+	defer sentinel.Close()
+	waitFor(t, func() bool { return sentinel.Ping(ctx).Err() == nil })
+
+	t.Setenv("REDIS_SENTINEL_MASTER", masterName)
+	t.Setenv("REDIS_SENTINEL_ADDRS", sentinelAddr)
+	t.Setenv("REDIS_SENTINEL_PASSWORD", sentinelPassword)
+	t.Setenv("REDIS_SENTINEL_USERNAME", "")
+	t.Setenv("REDIS_USERNAME", "")
+	t.Setenv("REDIS_TLS", "")
+	t.Setenv("REDIS_TLS_CA_FILE", "")
+	t.Setenv("REDIS_TLS_CERT_FILE", "")
+	t.Setenv("REDIS_TLS_KEY_FILE", "")
+	t.Setenv("REDIS_TLS_SERVER_NAME", "")
+	client, err := NewClient("127.0.0.1:1", redisPassword)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	waitFor(t, func() bool { return client.Ping(ctx).Err() == nil })
+	taskStore := redisstore.NewStore(client, redisstore.Options{})
+	if err := taskStore.MarkTaskDeleting(ctx, "default", "attempt-fenced"); !errors.Is(err, store.ErrNotFound) {
+		t.Fatalf("deleting absent task: %v", err)
+	}
+	const marker = "ax:task-deleted:default:attempt-fenced"
+	waitFor(t, func() bool { return replica.Get(ctx, marker).Val() == "1" })
+	if err := sentinel.Failover(ctx, masterName).Err(); err != nil {
+		t.Fatalf("requesting promotion: %v", err)
+	}
+	waitFor(t, func() bool {
+		addresses, err := sentinel.GetMasterAddrByName(ctx, masterName).Result()
+		return err == nil && len(addresses) == 2 && net.JoinHostPort(addresses[0], addresses[1]) == replicaAddr && client.Ping(ctx).Err() == nil
+	})
+	if got, err := client.Get(ctx, marker).Result(); err != nil || got != "1" {
+		t.Fatalf("tombstone after promotion: %q, %v", got, err)
+	}
+	if err := taskStore.SaveTask(ctx, &v1alpha1.Task{Metadata: &v1alpha1.ObjectMeta{Name: "attempt-fenced"}, Spec: &v1alpha1.TaskSpec{Image: "alpine"}}); !errors.Is(err, store.ErrTaskDeleted) {
+		t.Fatalf("late upsert after promotion: %v", err)
+	}
+	badPassword, err := NewClient("127.0.0.1:1", "wrong-password")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer badPassword.Close()
+	if err := badPassword.Ping(ctx).Err(); err == nil {
+		t.Fatal("Redis accepted wrong password")
+	}
+	t.Setenv("REDIS_SENTINEL_PASSWORD", "wrong-password")
+	badSentinel, err := NewClient("127.0.0.1:1", redisPassword)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer badSentinel.Close()
+	if err := badSentinel.Ping(ctx).Err(); err == nil {
+		t.Fatal("Sentinel accepted wrong password")
+	}
+}
