+				}
+				if tc.reason != "ActorResumeFailed" && len(tc.server.resumedActors) != 0 {
+					t.Fatal("resumed despite failed prerequisite")
+				}
+				if tc.reason == "TemplateCreationFailed" && len(tc.server.createdActors) != 0 {
+					t.Fatal("fell back to another template")
+				}
+				if tc.server.suspendErr != nil {
+					if !strings.Contains(err.Error(), "failed to stop existing execution") || got.Status.WorkerIp == "" {
+						t.Fatal("stop failure was hidden")
+					}
+				} else if got.Status.WorkerIp != "" {
+					t.Fatal("stale worker remained routable")
+				}
+			} else if err != nil {
+				t.Fatal(err)
+			}
+			if tc.reason != "" || tc.suspend {
+				if len(tc.server.suspendedActors) != 1 {
+					t.Fatal("did not attempt to stop execution")
+				}
+			}
+			if tc.suspend && (got.Status.Phase != "Suspended" || tc.server.createdTemplate != nil || len(tc.server.createdPolicies) != 0) {
+				t.Fatal("suspend depended on provisioning")
+			}
+			if tc.server.createdTemplate != nil {
+				foundControllerKey := false
+				for _, c := range tc.server.createdTemplate.GetContainers() {
