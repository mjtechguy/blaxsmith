+// ApplyEgressPolicy installs the immutable task's actor policy before resume.
+func (c *Client) ApplyEgressPolicy(ctx context.Context, atespace, actorName string, policy *v1alpha1.TaskEgress) error {
+	allowAll, cidrs := policy.GetAllowAll(), policy.GetCidrs()
+	if allowAll && len(cidrs) != 0 {
+		return fmt.Errorf("egress cannot combine allowAll and CIDRs")
+	}
+	for _, cidr := range cidrs {
+		if _, err := netip.ParsePrefix(cidr); err != nil {
+			return fmt.Errorf("egress requires an IP CIDR: %w", err)
+		}
+	}
+
+	var rules []*ateapipb.EgressRule
+	if allowAll {
+		rules = append(rules, &ateapipb.EgressRule{
+			All: &emptypb.Empty{},
+		})
+	} else {
+		if len(cidrs) > 0 {
+			rules = append(rules, &ateapipb.EgressRule{
+				Cidrs: &ateapipb.CIDRRule{
+					Cidrs: cidrs,
+				},
+			})
+		}
+	}
+
+	egressPolicy := &ateapipb.EgressPolicy{
+		Metadata: &ateapipb.ResourceMetadata{
+			Atespace: atespace,
+			Name:     "default",
+		},
+		Rules: rules,
+	}
+
+	actorRef := &ateapipb.ObjectRef{
+		Atespace: atespace,
+		Name:     actorName,
+	}
 
