+func TestBlaxsmithGatedTemplateUsesTransportReadiness(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		env  map[string]string
+		path string
+	}{
+		{"ordinary", nil, "/readyz"},
+		{"gated", map[string]string{"BLAXSMITH_BOOTSTRAP_PUBLIC_KEY": "synthetic"}, "/healthz"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			tmpl := BuildActorTemplate("space", "task", "image@sha256:test", nil, tc.env, nil, "gs://bucket")
+			if got := tmpl.Containers[0].Readyz.HttpGet.Path; got != tc.path {
+				t.Fatalf("Substrate readiness path = %q, want %q", got, tc.path)
