+func TestApplyEgressPolicy(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		policy    *v1alpha1.TaskEgress
+		exists    bool
+		wantRules int
+		wantErr   bool
+	}{
+		{"empty policy is persisted", nil, true, 0, false},
+		{"CIDR is persisted", &v1alpha1.TaskEgress{Cidrs: []string{"192.0.2.0/24"}}, false, 1, false},
+		{"allow all is persisted", &v1alpha1.TaskEgress{AllowAll: true}, false, 1, false},
+		{"hostname rejected", &v1alpha1.TaskEgress{Cidrs: []string{"example.com"}}, false, 0, true},
+		{"invalid CIDR rejected", &v1alpha1.TaskEgress{Cidrs: []string{"192.0.2.0/99"}}, false, 0, true},
+		{"ambiguous allow all rejected", &v1alpha1.TaskEgress{AllowAll: true, Cidrs: []string{"192.0.2.0/24"}}, false, 0, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			mock := &policyClient{exists: tc.exists}
+			client := &Client{control: mock}
+			err := client.ApplyEgressPolicy(context.Background(), "default", "actor", tc.policy)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("ApplyEgressPolicy() error = %v, wantErr = %t", err, tc.wantErr)
+			}
+			if tc.wantErr {
+				if mock.create != nil {
+					t.Fatal("unsupported rule reached the control API")
+				}
+				return
+			}
+			policy := mock.create
+			if tc.exists {
+				policy = mock.update
+				if policy == nil || policy.Metadata.Uid != "old" || policy.Metadata.Version != 2 {
+					t.Fatalf("policy update lost resource preconditions: %v", policy)
+				}
+			}
+			if policy == nil || len(policy.Rules) != tc.wantRules {
+				t.Fatalf("policy rules = %v, want %d", policy, tc.wantRules)
+			}
+		})
+	}
+}
