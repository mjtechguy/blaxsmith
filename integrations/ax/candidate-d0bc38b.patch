+// OpenCode Zen (provider "opencode") and OpenCode Go (provider "opencode-go")
+// keys are API keys of the same kind and take the same path as OpenAI and
+// Anthropic keys. Other OpenCode providers stay rejected.
+func TestOpenCodeModelKeyMatchesItsProviderPrefix(t *testing.T) {
+	bundle := func(provider string) []byte {
+		t.Helper()
+		model, _ := json.Marshal(map[string]any{"kind": "model_api_key", "attempt_id": "attempt-a",
+			"provider": provider, "expires_at": time.Now().Add(10 * time.Minute).Unix(), "api_key": "zen-key"})
+		body, err := json.Marshal(map[string]any{"schema": "blaxsmith.bootstrap-capabilities/v1alpha1",
+			"attempt_id": "attempt-a", "model": json.RawMessage(model)})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return body
+	}
+	command := func(model string) []string {
+		return []string{"/usr/local/bin/blaxsmith-tool-worker", `{"attempt_id":"attempt-a","profile":{"harness":"opencode","model":"` + model + `"}}`}
+	}
+	for _, c := range []struct{ provider, model string }{{"opencode", "opencode/big-pickle"}, {"opencode-go", "opencode-go/kimi-k2"}} {
+		_, data, err := decodeBootstrapPayload(bundle(c.provider), nil, command(c.model), modelPhase)
+		if err != nil || !strings.Contains(string(data), `"provider":"`+c.provider+`"`) || !strings.Contains(string(data), "zen-key") {
+			t.Fatalf("%s key: data=%q err=%v", c.provider, data, err)
+		}
+	}
+	for _, c := range []struct{ provider, model string }{
+		{"opencode", "openai/gpt-6-luna"}, {"openai", "opencode/big-pickle"}, {"opencode-go", "opencode/big-pickle"},
+		{"opencode", "opencode-go/kimi-k2"}, {"opencode-go", "anthropic/claude-x"}, {"gemini", "gemini/pro"},
+	} {
+		if _, _, err := decodeBootstrapPayload(bundle(c.provider), nil, command(c.model), modelPhase); err == nil {
+			t.Fatalf("%s key accepted for %s", c.provider, c.model)
+		}
+	}
+	if _, _, err := decodeBootstrapPayload(bundle("opencode"), nil, command("opencode/big-pickle"), setupPhase); err == nil {
+		t.Fatal("opencode key accepted during workspace setup")
+	}
+	if _, _, err := decodeBootstrapPayload(bundle("opencode-go"), nil, command("opencode-go/kimi-k2"), setupPhase); err == nil {
+		t.Fatal("opencode-go key accepted during workspace setup")
+	}
+}
