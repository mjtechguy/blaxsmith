+func TestModelCredentialNeedsMatchingPinnedCommandAndPrivateFile(t *testing.T) {
+	command := []string{"/usr/local/bin/blaxsmith-tool-worker", `{"attempt_id":"attempt-a","profile":{"harness":"codex","model":"gpt-6-luna"}}`}
+	model := func(attempt, provider string) json.RawMessage {
+		t.Helper()
