+	}
+	modelBundle, err := json.Marshal(map[string]any{"schema": "blaxsmith.bootstrap-capabilities/v1alpha1",
+		"attempt_id": "attempt-a", "model": model("attempt-a", "openai")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	git, data, err := decodeBootstrapPayload(modelBundle, nil, command, modelPhase)
+	if err != nil || git != nil || strings.Contains(string(data), `"kind"`) || !strings.Contains(string(data), "private-key") {
+		t.Fatalf("post-ready model payload decode: git=%v data=%q err=%v", git, data, err)
+	}
+	for _, candidate := range [][]string{{"/bin/sh", "-c", "true"}, {command[0], `{"attempt_id":"other","profile":{"harness":"codex","model":"gpt-6-luna"}}`}} {
+		if _, _, err := decodeBootstrapPayload(modelBundle, nil, candidate, modelPhase); err == nil {
+			t.Fatalf("mismatched command accepted: %q", candidate)
+		}
+	}
+	wrongProvider, _ := json.Marshal(map[string]any{"schema": "blaxsmith.bootstrap-capabilities/v1alpha1",
+		"attempt_id": "attempt-a", "model": model("attempt-a", "anthropic")})
+	if _, _, err := decodeBootstrapPayload(wrongProvider, nil, command, modelPhase); err == nil {
+		t.Fatal("wrong provider accepted")
+	}
+	if _, _, err := decodeBootstrapPayload(modelBundle, nil, command, setupPhase); err == nil {
+		t.Fatal("model credential accepted during workspace setup")
+	}
+	if !requiresModelCredential(command) || requiresModelCredential([]string{"sh", "-c", "true"}) {
+		t.Fatal("model-worker command gate is incorrect")
+	}
+	ws := &v1alpha1.Workspace{Spec: &v1alpha1.WorkspaceSpec{Git: []*v1alpha1.GitRepo{{
+		Repo: "https://github.com/owner/repo.git", Branch: "main",
+	}}}}
+	setupBundle, err := json.Marshal(map[string]any{"schema": "blaxsmith.bootstrap-capabilities/v1alpha1",
+		"attempt_id": "attempt-a", "git": map[string]string{"repo_url": "https://github.com/owner/repo.git",
+			"commit": strings.Repeat("a", 40), "username": "blaxsmith", "token": "private-git-token"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	git, data, err = decodeBootstrapPayload(setupBundle, []*v1alpha1.Workspace{ws}, command, setupPhase)
+	if err != nil || git == nil || git.RepoURL != "https://github.com/owner/repo.git" || data != nil {
+		t.Fatalf("setup Git payload: git=%+v model=%q err=%v", git, data, err)
+	}
+	if _, _, err := decodeBootstrapPayload(setupBundle, []*v1alpha1.Workspace{ws}, command, modelPhase); err == nil {
+		t.Fatal("Git credential accepted during model release")
+	}
+	combined, _ := json.Marshal(map[string]any{"schema": "blaxsmith.bootstrap-capabilities/v1alpha1",
+		"attempt_id": "attempt-a", "git": json.RawMessage(`{"repo_url":"https://github.com/owner/repo.git","commit":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","username":"u","token":"t"}`),
+		"model": model("attempt-a", "openai")})
+	if _, _, err := decodeBootstrapPayload(combined, []*v1alpha1.Workspace{ws}, command, setupPhase); err == nil {
+		t.Fatal("combined capability phases accepted during setup")
+	}
+	if _, _, err := decodeBootstrapPayload(combined, []*v1alpha1.Workspace{ws}, command, modelPhase); err == nil {
+		t.Fatal("combined capability phases accepted during model release")
+	}
+	root := t.TempDir()
+	if err := os.Chmod(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(root, "agent-credential.json")
+	if err := writeModelCredential(path, data); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Lstat(path)
+	if err != nil || info.Mode().Perm() != 0600 {
+		t.Fatalf("credential file mode: %v %v", info, err)
+	}
+	if err := writeModelCredential(path, data); err == nil {
+		t.Fatal("existing credential file was replaced")
+	}
+}
