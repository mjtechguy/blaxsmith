+func TestTaskDeletionTombstonesLateUpsert(t *testing.T) {
+	redisPath, err := exec.LookPath("redis-server")
+	if err != nil {
+		t.Skip("redis-server is required for atomic task deletion test")
+	}
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := listener.Addr().(*net.TCPAddr).Port
+	_ = listener.Close()
+	cmd := exec.Command(redisPath, "--bind", "127.0.0.1", "--port", strconv.Itoa(port), "--save", "", "--appendonly", "no")
+	cmd.Env = append(os.Environ(), "LC_ALL=C")
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = cmd.Process.Kill(); _ = cmd.Wait() })
+	ctx := t.Context()
+	client := redisclient.NewClient(&redisclient.Options{Addr: net.JoinHostPort("127.0.0.1", strconv.Itoa(port))})
+	t.Cleanup(func() { _ = client.Close() })
+	deadline := time.Now().Add(3 * time.Second)
+	for client.Ping(ctx).Err() != nil {
+		if time.Now().After(deadline) {
+			t.Fatal("redis-server did not start")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	s := NewStore(client, Options{KeyPrefix: "test"})
+	if err := s.MarkTaskDeleting(ctx, "org", "attempt-unseen"); !errors.Is(err, store.ErrNotFound) {
+		t.Fatalf("absent task deletion: %v", err)
+	}
+	unseen := &v1alpha1.Task{Metadata: &v1alpha1.ObjectMeta{Atespace: "org", Name: "attempt-unseen"}, Spec: &v1alpha1.TaskSpec{Image: "alpine"}}
+	if err := s.CreateTask(ctx, unseen); !errors.Is(err, store.ErrTaskDeleted) {
+		t.Fatalf("late initial upsert after absent delete: %v", err)
+	}
+	task := &v1alpha1.Task{Metadata: &v1alpha1.ObjectMeta{Atespace: "org", Name: "attempt-old"}, Spec: &v1alpha1.TaskSpec{Image: "alpine"}}
+	if err := s.CreateTask(ctx, task); err != nil {
+		t.Fatal(err)
+	}
+	running, err := s.SetTaskPhase(ctx, "org", "attempt-old", "Running")
+	if err != nil {
+		t.Fatal(err)
+	}
+	suspended, err := s.SetTaskPhase(ctx, "org", "attempt-old", "Suspended")
+	if err != nil || suspended.GetStatus().GetGeneration() <= running.GetStatus().GetGeneration() {
+		t.Fatalf("suspend lifecycle: %v / %v", suspended, err)
+	}
+	if err := s.UpdateTaskStatus(ctx, "org", "attempt-old", running.Status); !errors.Is(err, store.ErrConflict) {
+		t.Fatalf("stale observation replaced suspension: %v", err)
+	}
+	if err := s.UpdateTaskStatus(ctx, "org", "attempt-old", suspended.Status); err != nil {
+		t.Fatal(err)
+	}
+	var created atomic.Int32
+	var creators sync.WaitGroup
+	for i := range 32 {
+		creators.Go(func() {
+			err := s.CreateTask(ctx, &v1alpha1.Task{Metadata: &v1alpha1.ObjectMeta{Name: "create-race"}, Spec: &v1alpha1.TaskSpec{Image: fmt.Sprintf("candidate-%d", i)}})
+			if err == nil {
+				created.Add(1)
+			} else if !errors.Is(err, store.ErrAlreadyExists) {
+				t.Errorf("concurrent create: %v", err)
+			}
+		})
+	}
+	creators.Wait()
+	if created.Load() != 1 {
+		t.Fatalf("immutable creates won %d times", created.Load())
+	}
+
+	if err := s.MarkTaskDeleting(ctx, "org", "attempt-old"); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.CreateTask(ctx, task); !errors.Is(err, store.ErrTaskDeleted) {
+		t.Fatalf("late upsert during cleanup: %v", err)
+	}
+	if err := s.UpdateTaskStatus(ctx, "org", "attempt-old", &v1alpha1.TaskStatus{Phase: "Running"}); !errors.Is(err, store.ErrTaskDeleted) {
+		t.Fatalf("stale status overwrote Terminating: %v", err)
+	}
+	if err := s.DeleteTask(ctx, "org", "attempt-old"); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.CreateTask(ctx, task); !errors.Is(err, store.ErrTaskDeleted) {
+		t.Fatalf("late upsert after cleanup: %v", err)
+	}
+	if _, err := s.GetTask(ctx, "org", "attempt-old"); !errors.Is(err, store.ErrNotFound) {
+		t.Fatalf("deleted task became visible: %v", err)
+	}
+	if ttl := client.TTL(ctx, s.deletedTaskKey("org", "attempt-old")).Val(); ttl != -1 {
+		t.Fatalf("deletion marker must not expire: %v", ttl)
+	}
+	task.Metadata.Name = "attempt-new"
+	if err := s.CreateTask(ctx, task); err != nil {
+		t.Fatalf("new attempt name rejected: %v", err)
+	}
+}
