+
+	"github.com/google/ax/internal/workspace"
+	"github.com/google/ax/pkg/apis/v1alpha1"
+	"github.com/google/ax/runner"
+)
+
+func TestBlaxsmithBootstrapRejectsInvalidKey(t *testing.T) {
+	for _, value := range []string{"", "not-a-public-key"} {
+		t.Run(value, func(t *testing.T) {
+			t.Setenv("BLAXSMITH_BOOTSTRAP_PUBLIC_KEY", value)
+			h := newHarness(t)
+			if value == "" {
+				h.task.Spec.Env = []*v1alpha1.EnvVar{{Name: "BLAXSMITH_BOOTSTRAP_PUBLIC_KEY", Value: "task-key"}}
+			}
+			if err := runner.Run(context.Background(), h.cfg); err == nil {
+				t.Fatalf("key %q did not fail closed", value)
+			}
+			if _, err := os.Stat(h.wsPath); !os.IsNotExist(err) {
+				t.Fatalf("workspace created with invalid key: %v", err)
+			}
+		})
+	}
+}
+
+func TestBlaxsmithBootstrapGatesWorkspaceAndCommand(t *testing.T) {
+	public, private, err := ed25519.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("BLAXSMITH_BOOTSTRAP_PUBLIC_KEY", base64.StdEncoding.EncodeToString(public))
+	newGated := func() *harness {
+		return newHarness(t)
+	}
+	h := newGated()
+	started := filepath.Join(t.TempDir(), "started")
+	h.task.Spec.Command = []string{"touch", started}
+	h.start(t)
+	waitHealthy(t, h.cfg.Port)
+	first := readChallenge(t, h.cfg.Port, "setup")
+	if _, err := os.Stat(filepath.Join(workspace.AXDir, workspace.MarkerName(h.wsPath))); !os.IsNotExist(err) {
+		t.Fatalf("workspace set up before release: %v", err)
+	}
+	if _, err := os.Stat(started); !os.IsNotExist(err) {
+		t.Fatalf("command ran before release: %v", err)
+	}
+	if status := sendRelease(t, h.cfg.Port, signedRelease(first, private, "wrong-task")); status != http.StatusForbidden {
+		t.Fatalf("wrong-task signature status = %d", status)
+	}
+	if status := sendRelease(t, h.cfg.Port, signedRelease(first, private, first.Task)); status != http.StatusNoContent {
+		t.Fatalf("valid release status = %d", status)
+	}
+	if exit := h.waitExit(t); exit.Err != nil {
+		t.Fatalf("command failed after release: %+v", exit)
+	}
+	if _, err := os.Stat(started); err != nil {
+		t.Fatalf("command missing after release: %v", err)
+	}
+	if status := sendRelease(t, h.cfg.Port, signedRelease(first, private, first.Task)); status != http.StatusForbidden {
+		t.Fatalf("replayed release status = %d", status)
+	}
+
+	// A runner restored from the same pre-bootstrap template must get a new
+	// nonce; the old signed release cannot unlock it.
+	clone := newGated()
+	cloneStarted := filepath.Join(t.TempDir(), "clone-started")
+	clone.task.Spec.Command = []string{"touch", cloneStarted}
+	clone.start(t)
+	waitHealthy(t, clone.cfg.Port)
+	second := readChallenge(t, clone.cfg.Port, "setup")
+	if second.Nonce == first.Nonce {
+		t.Fatal("two runner instances reused the challenge")
+	}
+	if status := sendRelease(t, clone.cfg.Port, signedRelease(first, private, first.Task)); status != http.StatusForbidden {
+		t.Fatalf("cross-runner replay status = %d", status)
+	}
+	clone.cancel()
+	clone.waitFinished(t, 5*time.Second)
+	if _, err := os.Stat(cloneStarted); !os.IsNotExist(err) {
+		t.Fatalf("clone command ran without release: %v", err)
+	}
+}
+
+type bootstrapChallenge struct {
+	Nonce     string `json:"nonce"`
+	ExpiresAt int64  `json:"expires_at"`
+	Phase     string `json:"phase"`
+	Atespace  string `json:"atespace"`
+	Task      string `json:"task"`
+}
+
+func readChallenge(t *testing.T, port int, phases ...string) bootstrapChallenge {
+	t.Helper()
+	phase := "setup"
+	if len(phases) > 1 {
+		t.Fatal("readChallenge accepts one phase")
+	}
+	if len(phases) == 1 {
+		phase = phases[0]
+	}
+	response, err := http.Get(fmt.Sprintf("http://127.0.0.1:%d/blaxsmith/bootstrap/challenge?phase=%s", port, phase))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		t.Fatalf("challenge status = %d", response.StatusCode)
+	}
+	var challenge bootstrapChallenge
+	if err := json.NewDecoder(response.Body).Decode(&challenge); err != nil {
+		t.Fatal(err)
+	}
+	if challenge.Nonce == "" || challenge.ExpiresAt == 0 || challenge.Phase != phase {
+		t.Fatalf("invalid challenge: %+v", challenge)
+	}
+	return challenge
+}
+
+func signedRelease(c bootstrapChallenge, key ed25519.PrivateKey, task string) []byte {
+	message := []byte(fmt.Sprintf("blaxsmith/bootstrap/release/v3\n%s\n%s\n%d\n%s\n%s\n", c.Phase, c.Nonce, c.ExpiresAt, c.Atespace, task))
+	body, _ := json.Marshal(map[string]any{
+		"phase": c.Phase, "nonce": c.Nonce, "expires_at": c.ExpiresAt,
+		"signature": base64.StdEncoding.EncodeToString(ed25519.Sign(key, message)),
+	})
+	return body
+}
+
+func sendRelease(t *testing.T, port int, body []byte) int {
+	t.Helper()
+	response, err := http.Post(fmt.Sprintf("http://127.0.0.1:%d/blaxsmith/bootstrap/release", port), "application/json", bytes.NewReader(body))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	return response.StatusCode
+}
diff --git a/runner/command_exit.go b/runner/command_exit.go
new file mode 100644
index 0000000..7d1c3b5
--- /dev/null
+++ b/runner/command_exit.go
@@ -0,0 +1,87 @@
+package runner
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"net/http"
+	"os/exec"
+	"sync"
+	"syscall"
+	"time"
+)
+
+const commandExitSchema = "blaxsmith.command-exit/v1alpha1"
+
+// commandExitReadback is a read-only observation from the pinned runner. The
+// platform must authenticate the live actor and bind this to its own attempt
+// before signing a durable report. The child process cannot submit a result.
+type commandExitReadback struct {
+	Schema          string `json:"schema"`
+	ActivationNonce string `json:"activation_nonce"`
+	AXAtespace      string `json:"ax_atespace"`
+	AXTask          string `json:"ax_task"`
+	CommandSHA256   string `json:"command_sha256"`
+	ExitCode        int    `json:"exit_code"`
+	Signal          int    `json:"signal"`
+	Interrupted     bool   `json:"interrupted"`
+	Sequence        int64  `json:"sequence"`
+	ObservedAt      int64  `json:"observed_at"`
+}
+
+type commandExitObserver struct {
+	gate    *bootstrapGate
+	mu      sync.RWMutex
+	command string
+	report  *commandExitReadback
+}
+
+func newCommandExitObserver(gate *bootstrapGate, argv []string) *commandExitObserver {
+	if gate == nil || len(argv) == 0 {
+		return nil
+	}
+	encoded, _ := json.Marshal(argv)
+	sum := sha256.Sum256(encoded)
+	return &commandExitObserver{gate: gate, command: hex.EncodeToString(sum[:])}
+}
+
+func (o *commandExitObserver) record(cmd *exec.Cmd, interrupted bool) {
+	if o == nil || cmd.ProcessState == nil {
+		return
+	}
+	o.gate.mu.Lock()
+	if !o.gate.done {
+		o.gate.mu.Unlock()
+		return
+	}
+	report := commandExitReadback{Schema: commandExitSchema, ActivationNonce: o.gate.nonce,
+		AXAtespace: o.gate.atespace, AXTask: o.gate.task, CommandSHA256: o.command,
+		ExitCode: cmd.ProcessState.ExitCode(), Interrupted: interrupted, Sequence: 1,
+		ObservedAt: time.Now().UnixNano()}
+	o.gate.mu.Unlock()
+	if state, ok := cmd.ProcessState.Sys().(syscall.WaitStatus); ok && state.Signaled() {
+		report.Signal = int(state.Signal())
+	}
+	o.mu.Lock()
+	o.report = &report
+	o.mu.Unlock()
+}
+
+func (o *commandExitObserver) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		http.Error(w, "GET required", http.StatusMethodNotAllowed)
+		return
+	}
+	o.mu.RLock()
+	if o.report == nil {
+		o.mu.RUnlock()
+		w.WriteHeader(http.StatusAccepted)
+		return
+	}
+	report := *o.report
+	o.mu.RUnlock()
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(report)
+}
+
+var _ http.Handler = (*commandExitObserver)(nil)
diff --git a/runner/command_exit_test.go b/runner/command_exit_test.go
new file mode 100644
index 0000000..e19e5a3
--- /dev/null
+++ b/runner/command_exit_test.go
@@ -0,0 +1,70 @@
+package runner_test
+
+import (
+	"crypto/ed25519"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"testing"
+)
+
+func TestGatedCommandExitReadback(t *testing.T) {
+	public, private, err := ed25519.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("BLAXSMITH_BOOTSTRAP_PUBLIC_KEY", base64.StdEncoding.EncodeToString(public))
+	h := newHarness(t)
+	h.task.Spec.Command = []string{"sh", "-c", "exit 7"}
+	h.start(t)
+	waitHealthy(t, h.cfg.Port)
+	challenge := readChallenge(t, h.cfg.Port)
+	url := fmt.Sprintf("http://127.0.0.1:%d/blaxsmith/command-exit", h.cfg.Port)
+	checkStatus := func(want int) *http.Response {
+		t.Helper()
+		response, err := http.Get(url)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if response.StatusCode != want {
+			response.Body.Close()
+			t.Fatalf("exit readback status = %d, want %d", response.StatusCode, want)
+		}
+		return response
+	}
+	checkStatus(http.StatusAccepted).Body.Close()
+	if status := sendRelease(t, h.cfg.Port, signedRelease(challenge, private, challenge.Task)); status != http.StatusNoContent {
+		t.Fatalf("release status = %d", status)
+	}
+	if exit := h.waitExit(t); exit.ExitCode != 7 {
+		t.Fatalf("command exit = %+v", exit)
+	}
+	response := checkStatus(http.StatusOK)
+	defer response.Body.Close()
+	var report struct {
+		Schema          string `json:"schema"`
+		ActivationNonce string `json:"activation_nonce"`
+		AXAtespace      string `json:"ax_atespace"`
+		AXTask          string `json:"ax_task"`
+		CommandSHA256   string `json:"command_sha256"`
+		ExitCode        int    `json:"exit_code"`
+		Signal          int    `json:"signal"`
+		Interrupted     bool   `json:"interrupted"`
+		Sequence        int64  `json:"sequence"`
+		ObservedAt      int64  `json:"observed_at"`
+	}
+	if err := json.NewDecoder(response.Body).Decode(&report); err != nil {
+		t.Fatal(err)
+	}
+	command := sha256.Sum256([]byte(`["sh","-c","exit 7"]`))
+	if report.Schema != "blaxsmith.command-exit/v1alpha1" || report.ActivationNonce != challenge.Nonce ||
+		report.AXAtespace != challenge.Atespace || report.AXTask != challenge.Task ||
+		report.CommandSHA256 != hex.EncodeToString(command[:]) || report.ExitCode != 7 ||
+		report.Signal != 0 || report.Interrupted || report.Sequence != 1 || report.ObservedAt < 1 {
+		t.Fatalf("invalid command exit readback: %+v", report)
+	}
+}
diff --git a/runner/model_codex_auth_test.go b/runner/model_codex_auth_test.go
new file mode 100644
index 0000000..94a69c7
--- /dev/null
+++ b/runner/model_codex_auth_test.go
@@ -0,0 +1,99 @@
+package runner
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+// A Codex ChatGPT sign-in reaches only the Codex harness for provider openai,
+// as an auth.json whose refresh token is present and empty. Every other kind,
+// provider, harness, or token shape fails closed.
+func TestCodexAuthOnlyForCodexOpenAIWithoutRefreshToken(t *testing.T) {
+	auth := func(refresh any) string {
+		tokens := map[string]any{"id_token": "id.jwt.value", "access_token": "access.jwt.value", "account_id": "acct"}
+		if refresh != nil {
+			tokens["refresh_token"] = refresh
+		}
+		body, _ := json.Marshal(map[string]any{"OPENAI_API_KEY": nil, "tokens": tokens, "last_refresh": "2026-09-24T00:00:00Z"})
+		return string(body)
+	}
+	bundle := func(fields map[string]any) []byte {
+		t.Helper()
+		model := map[string]any{"kind": "model_codex_auth", "attempt_id": "attempt-a", "provider": "openai",
+			"expires_at": time.Now().Add(10 * time.Minute).Unix(), "codex_auth_json": auth("")}
+		for k, v := range fields {
+			if v == nil {
+				delete(model, k)
+			} else {
+				model[k] = v
+			}
+		}
+		encoded, _ := json.Marshal(model)
+		body, err := json.Marshal(map[string]any{"schema": "blaxsmith.bootstrap-capabilities/v1alpha1",
+			"attempt_id": "attempt-a", "model": json.RawMessage(encoded)})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return body
+	}
+	command := func(harness, model string) []string {
+		return []string{"/usr/local/bin/blaxsmith-tool-worker",
+			`{"attempt_id":"attempt-a","profile":{"harness":"` + harness + `","model":"` + model + `"}}`}
+	}
+	codex := command("codex", "gpt-6-luna")
+	_, data, err := decodeBootstrapPayload(bundle(nil), nil, codex, modelPhase)
+	if err != nil {
+		t.Fatalf("codex auth rejected: %v", err)
+	}
+	var written map[string]any
+	if err := json.Unmarshal(data, &written); err != nil || written["kind"] != nil || written["api_key"] != nil ||
+		written["provider"] != "openai" || written["attempt_id"] != "attempt-a" || written["codex_auth_json"] != auth("") {
+		t.Fatalf("codex credential file: %s %v", data, err)
+	}
+	rejected := map[string]struct {
+		fields  map[string]any
+		command []string
+	}{
+		"refresh token":         {map[string]any{"codex_auth_json": auth("rt-live")}, codex},
+		"missing refresh token": {map[string]any{"codex_auth_json": auth(nil)}, codex},
+		"null refresh token":    {map[string]any{"codex_auth_json": strings.Replace(auth(""), `"refresh_token":""`, `"refresh_token":null`, 1)}, codex},
+		"no tokens":             {map[string]any{"codex_auth_json": `{"OPENAI_API_KEY":"sk-x"}`}, codex},
+		"empty access token":    {map[string]any{"codex_auth_json": strings.Replace(auth(""), "access.jwt.value", "", 1)}, codex},
+		"not json":              {map[string]any{"codex_auth_json": "tokens"}, codex},
+		"trailing data":         {map[string]any{"codex_auth_json": auth("") + "{}"}, codex},
+		"oversized":             {map[string]any{"codex_auth_json": strings.Replace(auth(""), "acct", strings.Repeat("a", 16384), 1)}, codex},
+		"with api key":          {map[string]any{"api_key": "sk-extra"}, codex},
+		"anthropic provider":    {map[string]any{"provider": "anthropic"}, command("claude-code", "claude-x")},
+		"claude harness":        {nil, command("claude-code", "claude-x")},
+		"opencode harness":      {nil, command("opencode", "openai/gpt-6-luna")},
+		"opencode-go":           {map[string]any{"provider": "opencode-go"}, command("opencode", "opencode-go/kimi-k2")},
+		"other attempt":         {map[string]any{"attempt_id": "attempt-b"}, codex},
+		"expired":               {map[string]any{"expires_at": time.Now().Add(-time.Minute).Unix()}, codex},
+		"beyond an hour":        {map[string]any{"expires_at": time.Now().Add(2 * time.Hour).Unix()}, codex},
+		"unknown kind":          {map[string]any{"kind": "model_oauth"}, codex},
+		"api key kind":          {map[string]any{"kind": "model_api_key", "api_key": "sk-x"}, codex},
+	}
+	for name, c := range rejected {
+		if _, _, err := decodeBootstrapPayload(bundle(c.fields), nil, c.command, modelPhase); err == nil {
+			t.Fatalf("%s: codex auth accepted", name)
+		}
+	}
+	if _, _, err := decodeBootstrapPayload(bundle(nil), nil, codex, setupPhase); err == nil {
+		t.Fatal("codex auth accepted during workspace setup")
+	}
+	root := t.TempDir()
+	if err := os.Chmod(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(root, "agent-credential.json")
+	if err := writeModelCredential(path, data); err != nil {
+		t.Fatal(err)
+	}
+	if info, err := os.Lstat(path); err != nil || info.Mode().Perm() != 0600 {
+		t.Fatalf("codex credential file mode: %v %v", info, err)
+	}
+}
diff --git a/runner/model_credential.go b/runner/model_credential.go
new file mode 100644
index 0000000..151e82f
--- /dev/null
+++ b/runner/model_credential.go
@@ -0,0 +1,191 @@
+package runner
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/google/ax/internal/workspace"
+	"github.com/google/ax/pkg/apis/v1alpha1"
+)
+
+const modelCredentialFile = "/run/blaxsmith/agent-credential.json"
+const modelWorkerPath = "/usr/local/bin/blaxsmith-tool-worker"
+
+func requiresModelCredential(command []string) bool {
+	return len(command) == 2 && command[0] == modelWorkerPath
+}
+
+// Setup and model credentials use distinct actor-attested phases. Git access
+// can prepare the frozen checkout; a model key is accepted only after AX has
+// reported workspace readiness.
+func decodeBootstrapPayload(payload []byte, workspaces []*v1alpha1.Workspace, command []string, phase string) (*workspace.GitCredential, []byte, error) {
+	if len(payload) == 0 {
+		return nil, nil, nil
+	}
+	var bundle struct {
+		Schema    string          `json:"schema"`
+		AttemptID string          `json:"attempt_id"`
+		Git       json.RawMessage `json:"git"`
+		Model     json.RawMessage `json:"model"`
+	}
+	d := json.NewDecoder(bytes.NewReader(payload))
+	d.DisallowUnknownFields()
+	if err := d.Decode(&bundle); err != nil || d.Decode(new(any)) != io.EOF ||
+		bundle.Schema != "blaxsmith.bootstrap-capabilities/v1alpha1" || bundle.AttemptID == "" {
+		return nil, nil, errors.New("invalid bootstrap capability bundle")
+	}
+	switch phase {
+	case setupPhase:
+		if len(bundle.Git) == 0 || len(bundle.Model) != 0 {
+			return nil, nil, errors.New("setup phase accepts only Git credentials")
+		}
+		git, err := decodeGitPayload(bundle.Git, workspaces)
+		return git, nil, err
+	case modelPhase:
+		if len(bundle.Git) != 0 || len(bundle.Model) == 0 {
+			return nil, nil, errors.New("model phase accepts only model credentials")
+		}
+		model, err := decodeModelCredential(bundle.Model, command)
+		if err != nil {
+			return nil, nil, err
+		}
+		var selected struct {
+			AttemptID string `json:"attempt_id"`
+		}
+		if json.Unmarshal(model, &selected) != nil || selected.AttemptID != bundle.AttemptID {
+			clear(model)
+			return nil, nil, errors.New("bootstrap capability targets another attempt")
+		}
+		return nil, model, nil
+	default:
+		return nil, nil, errors.New("unsupported bootstrap phase")
+	}
+}
+
+func decodeModelCredential(payload []byte, command []string) ([]byte, error) {
+	if len(command) != 2 || command[0] != modelWorkerPath {
+		return nil, errors.New("model credential requires the pinned worker command")
+	}
+	var request struct {
+		AttemptID string `json:"attempt_id"`
+		Profile   struct {
+			Harness string `json:"harness"`
+			Model   string `json:"model"`
+		} `json:"profile"`
+	}
+	if err := json.Unmarshal([]byte(command[1]), &request); err != nil {
+		return nil, errors.New("invalid worker command")
+	}
+	var credential struct {
+		Kind          string `json:"kind"`
+		AttemptID     string `json:"attempt_id"`
+		Provider      string `json:"provider"`
+		ExpiresAt     int64  `json:"expires_at"`
+		APIKey        string `json:"api_key"`
+		CodexAuthJSON string `json:"codex_auth_json"`
+	}
+	d := json.NewDecoder(bytes.NewReader(payload))
+	d.DisallowUnknownFields()
+	if err := d.Decode(&credential); err != nil {
+		return nil, errors.New("invalid model credential")
+	}
+	if err := d.Decode(new(any)); err != io.EOF {
+		return nil, errors.New("invalid model credential")
+	}
+	provider := ""
+	switch request.Profile.Harness {
+	case "codex":
+		provider = "openai"
+	case "claude-code":
+		provider = "anthropic"
+	case "opencode":
+		provider, _, _ = strings.Cut(request.Profile.Model, "/")
+	}
+	now := time.Now()
+	if credential.Kind == "model_codex_auth" {
+		return decodeCodexAuth(request.AttemptID, request.Profile.Harness, credential.AttemptID,
+			credential.Provider, credential.ExpiresAt, credential.APIKey, credential.CodexAuthJSON, now)
+	}
+	if credential.Kind != "model_api_key" || credential.CodexAuthJSON != "" || credential.AttemptID == "" ||
+		credential.AttemptID != request.AttemptID || credential.Provider != provider ||
+		(provider != "openai" && provider != "anthropic" && provider != "opencode" && provider != "opencode-go") ||
+		!time.Unix(credential.ExpiresAt, 0).After(now) || time.Unix(credential.ExpiresAt, 0).After(now.Add(time.Hour)) ||
+		len(credential.APIKey) == 0 || len(credential.APIKey) > 8192 ||
+		strings.ContainsAny(credential.APIKey, "\r\n\x00") {
+		return nil, errors.New("model credential does not match the worker command")
+	}
+	return json.Marshal(struct {
+		AttemptID string `json:"attempt_id"`
+		Provider  string `json:"provider"`
+		ExpiresAt int64  `json:"expires_at"`
+		APIKey    string `json:"api_key"`
+	}{credential.AttemptID, credential.Provider, credential.ExpiresAt, credential.APIKey})
+}
+
+// decodeCodexAuth accepts a Codex ChatGPT sign-in only for the Codex harness
+// and provider openai. The platform keeps the refresh token: the auth.json
+// must carry an access token and an explicitly empty refresh token, so the
+// CLI in the guest can never spend or rotate the owner's login.
+func decodeCodexAuth(requestAttempt, harness, attemptID, provider string, expiresAt int64, apiKey, authJSON string, now time.Time) ([]byte, error) {
+	invalid := errors.New("model credential does not match the worker command")
+	if harness != "codex" || provider != "openai" || attemptID == "" || attemptID != requestAttempt || apiKey != "" ||
+		!time.Unix(expiresAt, 0).After(now) || time.Unix(expiresAt, 0).After(now.Add(time.Hour)) ||
+		len(authJSON) == 0 || len(authJSON) > 16384 || strings.ContainsRune(authJSON, 0) {
+		return nil, invalid
+	}
+	var file struct {
+		Tokens *struct {
+			IDToken      string  `json:"id_token"`
+			AccessToken  string  `json:"access_token"`
+			RefreshToken *string `json:"refresh_token"`
+		} `json:"tokens"`
+	}
+	d := json.NewDecoder(strings.NewReader(authJSON))
+	if err := d.Decode(&file); err != nil || d.Decode(new(any)) != io.EOF || file.Tokens == nil ||
+		file.Tokens.RefreshToken == nil || *file.Tokens.RefreshToken != "" || file.Tokens.AccessToken == "" ||
+		strings.ContainsAny(file.Tokens.AccessToken+file.Tokens.IDToken, "\r\n\x00") {
+		return nil, invalid
+	}
+	return json.Marshal(struct {
+		AttemptID     string `json:"attempt_id"`
+		Provider      string `json:"provider"`
+		ExpiresAt     int64  `json:"expires_at"`
+		CodexAuthJSON string `json:"codex_auth_json"`
+	}{attemptID, provider, expiresAt, authJSON})
+}
+
+// The image owns /run/blaxsmith before the task starts. Never follow a
+// workspace-selected path or replace a file left by an older actor snapshot.
+func writeModelCredential(path string, data []byte) error {
+	dir := filepath.Dir(path)
+	info, err := os.Lstat(dir)
+	if err != nil || !info.IsDir() || info.Mode().Perm() != 0700 {
+		return errors.New("private model credential directory unavailable")
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || stat.Uid != uint32(os.Geteuid()) {
+		return errors.New("model credential directory owner mismatch")
+	}
+	f, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+	if err != nil {
+		return errors.New("model credential file unavailable")
+	}
+	defer f.Close()
+	if _, err := f.Write(data); err != nil {
+		_ = os.Remove(path)
+		return fmt.Errorf("write model credential: %w", err)
+	}
+	if err := f.Sync(); err != nil {
+		_ = os.Remove(path)
+		return fmt.Errorf("sync model credential: %w", err)
+	}
+	return nil
+}
