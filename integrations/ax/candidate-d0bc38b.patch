+			go server.Serve(lis)
+			defer server.Stop()
+			client, err := substrate.NewClient(lis.Addr().String(), grpc.WithTransportCredentials(insecure.NewCredentials()))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer client.Close()
+			r := controller.NewTaskReconciler(client, "default-template", "ax-system")
+			if tc.name == "controller signer injected" || tc.name == "task signer override" || tc.name == "unapproved runner image" {
+				r.BootstrapPublicKey = "controller-public-key"
+				r.BootstrapRunnerImage = "example.invalid/runner"
+				if tc.name == "unapproved runner image" {
+					r.BootstrapRunnerImage = "example.invalid/other"
+				}
+			}
+			r.WorkspaceReadyTimeout = time.Millisecond
+			task := &v1alpha1.Task{Metadata: &v1alpha1.ObjectMeta{Name: "boundary", Atespace: "test"}, Spec: &v1alpha1.TaskSpec{Image: "example.invalid/runner"}, Status: &v1alpha1.TaskStatus{WorkerIp: "prior-worker", Phase: "Running"}}
+			if tc.suspend {
+				task.Status.Phase = "Suspended"
+			}
+			if tc.name == "invalid egress" {
+				task.Spec.Egress = &v1alpha1.TaskEgress{Cidrs: []string{"example.com"}}
+			}
+			if tc.name == "missing workspace" {
+				task.Spec.Workspaces = []*v1alpha1.WorkspaceRef{{Name: "missing"}}
+			}
+			if tc.name == "task signer override" {
+				task.Spec.Env = []*v1alpha1.EnvVar{{Name: "BLAXSMITH_BOOTSTRAP_PUBLIC_KEY", Value: "task-public-key"}}
+			}
+			if tc.name == "empty egress allowlist" {
+				task.Spec.Egress = &v1alpha1.TaskEgress{}
+			}
+			got, err := r.Reconcile(context.Background(), task)
+			if tc.name == "empty egress allowlist" && len(tc.server.createdPolicies) != 1 {
+				t.Fatal("empty allowlist did not install a deny policy")
+			}
+			if tc.name == "no policy defaults deny" && (tc.server.lastPolicy == nil || len(tc.server.lastPolicy.Rules) != 0) {
+				t.Fatal("missing policy installed permissive policy")
