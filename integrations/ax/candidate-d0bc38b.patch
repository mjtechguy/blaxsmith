+	"sync"
+	"time"
+
+	"github.com/google/ax/internal/workspace"
+	"github.com/google/ax/pkg/apis/v1alpha1"
+)
+
+const bootstrapKeyEnv = "BLAXSMITH_BOOTSTRAP_PUBLIC_KEY"
+const challengeTTL = 2 * time.Minute
+const (
+	setupPhase = "setup"
+	modelPhase = "model"
+)
+
+// bootstrapGate only releases startup. It never accepts or stores credentials.
+// The signer must independently verify the live actor before signing a release.
+type bootstrapGate struct {
+	key           ed25519.PublicKey
+	atespace      string
+	task          string
+	phase         string
+	requiresModel bool
+	mu            sync.Mutex
+	nonce         string
+	expires       time.Time
+	recipient     *ecdh.PrivateKey
+	payload       []byte
+	released      chan struct{}
+	phaseDone     bool
+	done          bool
+}
+
+func newBootstrapGate(task *v1alpha1.Task) (*bootstrapGate, error) {
+	for _, env := range task.GetSpec().GetEnv() {
+		if env.GetName() == bootstrapKeyEnv {
+			return nil, fmt.Errorf("task cannot choose %s", bootstrapKeyEnv)
+		}
+	}
+	encoded := os.Getenv(bootstrapKeyEnv)
+	if encoded == "" {
+		return nil, nil
+	}
+	key, err := base64.StdEncoding.DecodeString(encoded)
+	if err != nil || len(key) != ed25519.PublicKeySize {
+		return nil, fmt.Errorf("invalid %s", bootstrapKeyEnv)
+	}
+	meta := task.GetMetadata()
+	if meta.GetAtespace() == "" || meta.GetName() == "" {
+		return nil, fmt.Errorf("bootstrap task reference is required")
+	}
+	requiresModel := requiresModelCredential(task.GetSpec().GetCommand())
+	return &bootstrapGate{key: key, atespace: meta.GetAtespace(), task: meta.GetName(), phase: setupPhase,
+		requiresModel: requiresModel, released: make(chan struct{})}, nil
+}
+
+func (g *bootstrapGate) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	switch r.URL.Path {
+	case "/blaxsmith/bootstrap/challenge":
+		if r.Method != http.MethodGet {
+			http.Error(w, "GET required", http.StatusMethodNotAllowed)
+			return
+		}
+		g.challenge(w, r)
+	case "/blaxsmith/bootstrap/release":
+		if r.Method != http.MethodPost {
+			http.Error(w, "POST required", http.StatusMethodNotAllowed)
+			return
+		}
+		g.release(w, r)
+	default:
+		http.NotFound(w, r)
+	}
+}
+
+func (g *bootstrapGate) challenge(w http.ResponseWriter, r *http.Request) {
+	g.mu.Lock()
+	if g.done || g.phaseDone {
+		g.mu.Unlock()
+		http.Error(w, "already released", http.StatusGone)
+		return
+	}
+	if r.URL.Query().Get("phase") != g.phase {
+		g.mu.Unlock()
+		http.Error(w, "bootstrap phase mismatch", http.StatusConflict)
+		return
+	}
+	if g.nonce == "" || !time.Now().Before(g.expires) {
+		var random [32]byte
+		if _, err := rand.Read(random[:]); err != nil {
+			g.mu.Unlock()
+			http.Error(w, "challenge unavailable", http.StatusServiceUnavailable)
+			return
+		}
+		recipient, err := ecdh.X25519().GenerateKey(rand.Reader)
+		if err != nil {
+			g.mu.Unlock()
+			http.Error(w, "challenge unavailable", http.StatusServiceUnavailable)
+			return
+		}
+		g.nonce = base64.RawURLEncoding.EncodeToString(random[:])
+		g.expires = time.Now().Add(challengeTTL)
+		g.recipient = recipient
+	}
+	response := struct {
+		Nonce        string `json:"nonce"`
+		ExpiresAt    int64  `json:"expires_at"`
+		Phase        string `json:"phase"`
+		Atespace     string `json:"atespace"`
+		Task         string `json:"task"`
+		RecipientKey string `json:"recipient_key"`
+	}{g.nonce, g.expires.Unix(), g.phase, g.atespace, g.task,
+		base64.RawURLEncoding.EncodeToString(g.recipient.PublicKey().Bytes())}
+	g.mu.Unlock()
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(response)
+}
+
+func (g *bootstrapGate) release(w http.ResponseWriter, r *http.Request) {
+	var request struct {
+		Phase     string             `json:"phase"`
+		Nonce     string             `json:"nonce"`
+		ExpiresAt int64              `json:"expires_at"`
+		Signature string             `json:"signature"`
+		Envelope  *bootstrapEnvelope `json:"envelope,omitempty"`
+	}
+	decoder := json.NewDecoder(http.MaxBytesReader(w, r.Body, 50000))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&request); err != nil {
+		http.Error(w, "invalid release", http.StatusBadRequest)
+		return
+	}
+	if err := decoder.Decode(new(any)); err != io.EOF {
+		http.Error(w, "invalid release", http.StatusBadRequest)
+		return
+	}
+	signature, err := base64.StdEncoding.DecodeString(request.Signature)
+	if err != nil {
+		http.Error(w, "invalid release", http.StatusForbidden)
+		return
+	}
+	g.mu.Lock()
+	message := []byte("blaxsmith/bootstrap/release/v3\n" + request.Phase + "\n" + request.Nonce + "\n" + strconv.FormatInt(request.ExpiresAt, 10) + "\n" + g.atespace + "\n" + g.task + "\n")
+	if request.Envelope != nil {
+		encoded, _ := json.Marshal(request.Envelope)
+		digest := sha256.Sum256(encoded)
+		message = []byte("blaxsmith/bootstrap/release/v3\n" + request.Phase + "\n" + request.Nonce + "\n" + strconv.FormatInt(request.ExpiresAt, 10) + "\n" + g.atespace + "\n" + g.task + "\n" + base64.RawURLEncoding.EncodeToString(digest[:]) + "\n")
+	}
+	if g.done || g.phaseDone || request.Phase != g.phase || g.nonce == "" || request.Nonce != g.nonce ||
+		request.ExpiresAt != g.expires.Unix() || !time.Now().Before(g.expires) || !ed25519.Verify(g.key, message, signature) {
+		g.mu.Unlock()
+		http.Error(w, "release denied", http.StatusForbidden)
+		return
+	}
+	if request.Envelope != nil {
+		payload, err := g.open(*request.Envelope)
+		if err != nil {
+			g.mu.Unlock()
+			http.Error(w, "release denied", http.StatusForbidden)
+			return
+		}
+		g.payload = payload
+	}
+	g.phaseDone = true
+	close(g.released)
+	g.mu.Unlock()
+	w.WriteHeader(http.StatusNoContent)
+}
+
+type bootstrapEnvelope struct {
+	EphemeralKey string `json:"ephemeral_key"`
+	Nonce        string `json:"nonce"`
+	Ciphertext   string `json:"ciphertext"`
+}
+
+func (g *bootstrapGate) open(envelope bootstrapEnvelope) ([]byte, error) {
+	ephBytes, err := base64.RawURLEncoding.DecodeString(envelope.EphemeralKey)
+	if err != nil || len(ephBytes) != 32 || g.recipient == nil {
+		return nil, fmt.Errorf("invalid ephemeral key")
+	}
+	eph, err := ecdh.X25519().NewPublicKey(ephBytes)
+	if err != nil {
+		return nil, err
+	}
+	shared, err := g.recipient.ECDH(eph)
+	if err != nil {
+		return nil, err
+	}
+	salt, _ := base64.RawURLEncoding.DecodeString(g.nonce)
+	key, err := hkdf.Key(sha256.New, shared, salt, "blaxsmith/bootstrap-envelope/v1", 32)
+	if err != nil {
+		return nil, err
+	}
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, err
+	}
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, err
+	}
+	nonce, err := base64.RawURLEncoding.DecodeString(envelope.Nonce)
+	if err != nil || len(nonce) != aead.NonceSize() {
+		return nil, fmt.Errorf("invalid envelope nonce")
+	}
+	ciphertext, err := base64.RawURLEncoding.DecodeString(envelope.Ciphertext)
+	if err != nil || len(ciphertext) > 32800 {
+		return nil, fmt.Errorf("invalid envelope ciphertext")
+	}
+	context, _ := json.Marshal([]string{g.phase, g.nonce, strconv.FormatInt(g.expires.Unix(), 10), g.atespace, g.task, base64.RawURLEncoding.EncodeToString(g.recipient.PublicKey().Bytes())})
+	plain, err := aead.Open(nil, nonce, ciphertext, context)
+	if err != nil || len(plain) == 0 || len(plain) > 32768 {
+		return nil, fmt.Errorf("invalid envelope plaintext")
+	}
+	return plain, nil
+}
+
+func (g *bootstrapGate) takePayload(phase string) ([]byte, error) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.phase != phase || !g.phaseDone {
+		return nil, fmt.Errorf("bootstrap phase not released")
+	}
+	payload := g.payload
+	g.payload = nil
+	g.recipient = nil
+	g.phaseDone = false
+	if phase == setupPhase && g.requiresModel {
+		g.phase = modelPhase
+		g.nonce = ""
+		g.expires = time.Time{}
+		g.released = make(chan struct{})
+	} else {
+		g.done = true
+	}
+	return payload, nil
+}
+
+func decodeGitPayload(payload []byte, workspaces []*v1alpha1.Workspace) (*workspace.GitCredential, error) {
+	var setup struct {
+		RepoURL  string `json:"repo_url"`
+		Commit   string `json:"commit"`
+		Username string `json:"username"`
+		Token    string `json:"token"`
+	}
+	decoder := json.NewDecoder(bytes.NewReader(payload))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&setup); err != nil {
+		return nil, err
+	}
+	if err := decoder.Decode(new(any)); err != io.EOF {
+		return nil, fmt.Errorf("invalid trailing payload")
+	}
+	u, err := url.Parse(setup.RepoURL)
+	if err != nil || u.Scheme != "https" || u.Hostname() == "" || u.Path == "" || u.Path == "/" || u.Opaque != "" || u.User != nil || u.RawQuery != "" || u.Fragment != "" || len(setup.Commit) != 40 && len(setup.Commit) != 64 || setup.Commit != strings.ToLower(setup.Commit) || len(setup.Username) == 0 || len(setup.Username) > 128 || len(setup.Token) == 0 || len(setup.Token) > 8192 || strings.ContainsAny(setup.RepoURL+setup.Username+setup.Token, "\r\n\x00") {
+		return nil, fmt.Errorf("invalid Git credential")
+	}
+	if _, err := hex.DecodeString(setup.Commit); err != nil {
+		return nil, fmt.Errorf("invalid Git commit")
+	}
+	for _, ws := range workspaces {
+		if ws == nil || ws.Spec == nil {
+			continue
+		}
+		for _, repo := range ws.Spec.Git {
+			if repo != nil && repo.Repo == setup.RepoURL {
+				return &workspace.GitCredential{RepoURL: setup.RepoURL, Commit: setup.Commit, Username: setup.Username, Token: []byte(setup.Token)}, nil
+			}
+		}
+	}
+	return nil, fmt.Errorf("credential repository is not a workspace input")
+}
+
+var _ http.Handler = (*bootstrapGate)(nil)
diff --git a/runner/bootstrap_payload_test.go b/runner/bootstrap_payload_test.go
new file mode 100644
index 0000000..75c060c
--- /dev/null
+++ b/runner/bootstrap_payload_test.go
@@ -0,0 +1,134 @@
+package runner
+
+import (
+	"bytes"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/ecdh"
+	"crypto/ed25519"
+	"crypto/hkdf"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"testing"
+
+	"github.com/google/ax/pkg/apis/v1alpha1"
+)
+
+func TestEncryptedReleaseBindsGuestKeyAndCiphertext(t *testing.T) {
+	public, signer, err := ed25519.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv(bootstrapKeyEnv, base64.StdEncoding.EncodeToString(public))
+	newGate := func() (*bootstrapGate, *httptest.Server, map[string]any) {
+		t.Helper()
+		gate, err := newBootstrapGate(&v1alpha1.Task{Metadata: &v1alpha1.ObjectMeta{Atespace: "team", Name: "task"}, Spec: &v1alpha1.TaskSpec{}})
+		if err != nil {
+			t.Fatal(err)
+		}
+		server := httptest.NewServer(gate)
+		response, err := http.Get(server.URL + "/blaxsmith/bootstrap/challenge?phase=setup")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer response.Body.Close()
+		var challenge map[string]any
+		if err := json.NewDecoder(response.Body).Decode(&challenge); err != nil {
+			t.Fatal(err)
+		}
+		return gate, server, challenge
+	}
+	gate, server, challenge := newGate()
+	defer server.Close()
+	plaintext := []byte(`{"repo_url":"https://git.example/repo.git","username":"test","token":"synthetic-token"}`)
+	envelope := sealTestEnvelope(t, challenge, plaintext)
+	release := func(server *httptest.Server, challenge map[string]any, envelope bootstrapEnvelope) int {
+		t.Helper()
+		nonce := challenge["nonce"].(string)
+		expiry := int64(challenge["expires_at"].(float64))
+		encoded, _ := json.Marshal(envelope)
+		digest := sha256.Sum256(encoded)
+		message := []byte(fmt.Sprintf("blaxsmith/bootstrap/release/v3\n%s\n%s\n%d\n%s\n%s\n%s\n", challenge["phase"].(string), nonce, expiry, "team", "task", base64.RawURLEncoding.EncodeToString(digest[:])))
+		body, _ := json.Marshal(map[string]any{"phase": challenge["phase"], "nonce": nonce, "expires_at": expiry, "signature": base64.StdEncoding.EncodeToString(ed25519.Sign(signer, message)), "envelope": envelope})
+		response, err := http.Post(server.URL+"/blaxsmith/bootstrap/release", "application/json", bytes.NewReader(body))
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer response.Body.Close()
+		_, _ = io.Copy(io.Discard, response.Body)
+		return response.StatusCode
+	}
+	if status := release(server, challenge, envelope); status != http.StatusNoContent {
+		t.Fatalf("encrypted release status = %d", status)
+	}
+	if got, err := gate.takePayload(setupPhase); err != nil || !bytes.Equal(got, plaintext) {
+		t.Fatalf("guest did not receive plaintext: %v", err)
+	}
+	if status := release(server, challenge, envelope); status != http.StatusForbidden {
+		t.Fatalf("replay status = %d", status)
+	}
+	secondGate, secondServer, secondChallenge := newGate()
+	defer secondServer.Close()
+	if secondGate == nil {
+		t.Fatal("missing second gate")
+	}
+	if status := release(secondServer, secondChallenge, envelope); status != http.StatusForbidden {
+		t.Fatalf("other guest accepted ciphertext: %d", status)
+	}
+	tamperedGate, tamperedServer, tamperedChallenge := newGate()
+	defer tamperedServer.Close()
+	tampered := sealTestEnvelope(t, tamperedChallenge, plaintext)
+	tampered.Ciphertext = base64.RawURLEncoding.EncodeToString([]byte("tampered"))
+	if status := release(tamperedServer, tamperedChallenge, tampered); status != http.StatusForbidden {
+		t.Fatalf("tampered ciphertext status = %d", status)
+	}
+	if tamperedGate.done {
+		t.Fatal("tampered release opened gate")
+	}
+}
+
+func sealTestEnvelope(t *testing.T, challenge map[string]any, plaintext []byte) bootstrapEnvelope {
+	t.Helper()
+	recipientBytes, err := base64.RawURLEncoding.DecodeString(challenge["recipient_key"].(string))
+	if err != nil {
+		t.Fatal(err)
+	}
+	recipient, err := ecdh.X25519().NewPublicKey(recipientBytes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	eph, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	shared, err := eph.ECDH(recipient)
+	if err != nil {
+		t.Fatal(err)
+	}
+	salt, _ := base64.RawURLEncoding.DecodeString(challenge["nonce"].(string))
+	key, err := hkdf.Key(sha256.New, shared, salt, "blaxsmith/bootstrap-envelope/v1", 32)
+	if err != nil {
+		t.Fatal(err)
+	}
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		t.Fatal(err)
+	}
+	iv := make([]byte, aead.NonceSize())
+	if _, err := rand.Read(iv); err != nil {
+		t.Fatal(err)
+	}
+	context, _ := json.Marshal([]string{challenge["phase"].(string), challenge["nonce"].(string), strconv.FormatInt(int64(challenge["expires_at"].(float64)), 10), "team", "task", challenge["recipient_key"].(string)})
+	return bootstrapEnvelope{base64.RawURLEncoding.EncodeToString(eph.PublicKey().Bytes()), base64.RawURLEncoding.EncodeToString(iv), base64.RawURLEncoding.EncodeToString(aead.Seal(nil, iv, plaintext, context))}
+}
