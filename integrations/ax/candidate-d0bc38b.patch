+import (
+	"context"
+	"net"
+	"os"
+	"os/exec"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/google/ax/pkg/apis/v1alpha1"
+	redisclient "github.com/redis/go-redis/v9"
+)
+
+func TestPendingEventRecoveredAfterRedisRestart(t *testing.T) {
+	redisPath, err := exec.LookPath("redis-server")
+	if err != nil {
+		t.Skip("redis-server is required for pending recovery test")
+	}
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := listener.Addr().(*net.TCPAddr).Port
+	_ = listener.Close()
+	addr := net.JoinHostPort("127.0.0.1", strconv.Itoa(port))
+	dir := t.TempDir()
+	var server *exec.Cmd
+	start := func() {
+		server = exec.Command(redisPath, "--bind", "127.0.0.1", "--port", strconv.Itoa(port),
+			"--save", "", "--appendonly", "yes", "--appendfsync", "always", "--dir", dir)
+		server.Env = append(os.Environ(), "LC_ALL=C")
+		if err := server.Start(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	start()
+	t.Cleanup(func() {
+		if server != nil {
+			_ = server.Process.Kill()
+			_ = server.Wait()
+		}
+	})
+	ctx := t.Context()
+	client := redisclient.NewClient(&redisclient.Options{Addr: addr})
+	t.Cleanup(func() { _ = client.Close() })
+	waitReady := func() {
+		deadline := time.Now().Add(5 * time.Second)
+		for client.Ping(ctx).Err() != nil {
+			if time.Now().After(deadline) {
+				t.Fatal("redis-server did not start")
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+	}
+	waitReady()
+	s := NewStore(client, Options{KeyPrefix: "recovery", StreamName: "recovery:tasks", ReadBlock: 20 * time.Millisecond})
+	dead, err := s.Subscribe(ctx, "controllers", "dead")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := s.CreateTask(ctx, &v1alpha1.Task{
+		Metadata: &v1alpha1.ObjectMeta{Atespace: "org", Name: "attempt"},
+		Spec:     &v1alpha1.TaskSpec{Image: "alpine"},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	ev, err := dead.Next(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := dead.Renew(ctx, ev); err != nil {
+		t.Fatal(err)
+	}
+	// A live owner's refreshed entry must not be stolen.
+	if entries, _, err := client.XAutoClaim(ctx, &redisclient.XAutoClaimArgs{
+		Stream: s.opts.StreamName, Group: "controllers", Consumer: "other",
+		MinIdle: claimMinIdle, Start: "0-0", Count: 1,
+	}).Result(); err != nil || len(entries) != 0 {
+		t.Fatalf("claimed live entry: %v, %v", entries, err)
+	}
+	_ = dead.Close() // controller died before Ack
+	// Backdate pending idle time without sleeping a minute.
+	if err := client.Do(ctx, "XCLAIM", s.opts.StreamName, "controllers", "dead", 0,
+		ev.ID, "IDLE", int64((claimMinIdle+time.Second)/time.Millisecond), "JUSTID").Err(); err != nil {
+		t.Fatal(err)
+	}
+	_ = server.Process.Kill()
+	_ = server.Wait()
+	server = nil
+	start()
+	waitReady()
+	replacement, err := s.Subscribe(ctx, "controllers", "replacement")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer replacement.Close()
+	nextCtx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	recovered, err := replacement.Next(nextCtx)
+	if err != nil || recovered.ID != ev.ID {
+		t.Fatalf("pending event was not recovered: %+v, %v", recovered, err)
+	}
+	if err := dead.Ack(ctx, ev); err == nil {
+		t.Fatal("former owner acknowledged a reclaimed event")
+	}
+	if err := replacement.Renew(ctx, recovered); err != nil {
+		t.Fatal(err)
+	}
+	if err := replacement.Ack(ctx, recovered); err != nil {
+		t.Fatal(err)
+	}
+	if pending := client.XPending(ctx, s.opts.StreamName, "controllers").Val(); pending.Count != 0 {
+		t.Fatalf("acknowledged entry remains pending: %d", pending.Count)
+	}
+}
