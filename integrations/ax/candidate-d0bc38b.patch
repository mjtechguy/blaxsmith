+				t.Fatalf("expected one bounded retry, got %d resume calls", len(tc.server.resumedActors))
+			}
+			if tc.reason != "" {
+				if err == nil || got.Status.Phase != "Failed" {
+					t.Fatalf("expected blocked execution, got %v / %v", got.Status, err)
+				}
+				assertCondition(t, got, "Ready", "False", tc.reason)
+				if tc.reason == "ActorResumeFailed" && len(tc.server.resumedActors) != 1 {
