+	"crypto/x509"
+	"fmt"
+	"net"
+	"os"
+	"strconv"
+	"strings"
+
+	"github.com/redis/go-redis/v9"
+)
+
+// NewClient keeps the single-address path for local AX and enables Sentinel
+// discovery only when both REDIS_SENTINEL_MASTER and REDIS_SENTINEL_ADDRS are set.
+func NewClient(addr, password string) (*redis.Client, error) {
+	tlsConfig, err := redisTLS()
+	if err != nil {
+		return nil, err
+	}
+	master := os.Getenv("REDIS_SENTINEL_MASTER")
+	addresses := os.Getenv("REDIS_SENTINEL_ADDRS")
+	if (master == "") != (addresses == "") {
+		return nil, fmt.Errorf("REDIS_SENTINEL_MASTER and REDIS_SENTINEL_ADDRS must be set together")
+	}
+	if master == "" {
+		if os.Getenv("REDIS_SENTINEL_USERNAME") != "" || os.Getenv("REDIS_SENTINEL_PASSWORD") != "" {
+			return nil, fmt.Errorf("Sentinel credentials require Sentinel discovery")
+		}
+		return redis.NewClient(&redis.Options{
+			Addr: addr, Username: os.Getenv("REDIS_USERNAME"), Password: password, TLSConfig: tlsConfig,
+		}), nil
+	}
+	var sentinelAddrs []string
+	for _, address := range strings.Split(addresses, ",") {
+		address = strings.TrimSpace(address)
+		if _, _, err := net.SplitHostPort(address); err != nil {
+			return nil, fmt.Errorf("invalid Sentinel address %q: %w", address, err)
+		}
+		sentinelAddrs = append(sentinelAddrs, address)
+	}
+	return redis.NewFailoverClient(&redis.FailoverOptions{
+		MasterName: master, SentinelAddrs: sentinelAddrs,
+		Username: os.Getenv("REDIS_USERNAME"), Password: password,
+		SentinelUsername: os.Getenv("REDIS_SENTINEL_USERNAME"), SentinelPassword: os.Getenv("REDIS_SENTINEL_PASSWORD"),
+		TLSConfig: tlsConfig,
+	}), nil
+}
+
+func redisTLS() (*tls.Config, error) {
+	enabled := os.Getenv("REDIS_TLS")
+	if enabled == "" {
+		enabled = "false"
+	}
+	useTLS, err := strconv.ParseBool(enabled)
+	if err != nil {
+		return nil, fmt.Errorf("invalid REDIS_TLS: %w", err)
+	}
+	caFile, certFile, keyFile := os.Getenv("REDIS_TLS_CA_FILE"), os.Getenv("REDIS_TLS_CERT_FILE"), os.Getenv("REDIS_TLS_KEY_FILE")
+	serverName := os.Getenv("REDIS_TLS_SERVER_NAME")
+	if !useTLS {
+		if caFile != "" || certFile != "" || keyFile != "" || serverName != "" {
+			return nil, fmt.Errorf("REDIS_TLS must be true when Redis TLS settings are provided")
+		}
+		return nil, nil
+	}
+	if (certFile == "") != (keyFile == "") {
+		return nil, fmt.Errorf("REDIS_TLS_CERT_FILE and REDIS_TLS_KEY_FILE must be set together")
+	}
+	config := &tls.Config{MinVersion: tls.VersionTLS12, ServerName: serverName}
+	if caFile != "" {
+		roots, err := x509.SystemCertPool()
+		if err != nil {
+			return nil, fmt.Errorf("loading system CAs: %w", err)
+		}
+		if roots == nil {
+			roots = x509.NewCertPool()
+		}
+		pem, err := os.ReadFile(caFile)
+		if err != nil {
+			return nil, fmt.Errorf("reading REDIS_TLS_CA_FILE: %w", err)
+		}
+		if !roots.AppendCertsFromPEM(pem) {
+			return nil, fmt.Errorf("REDIS_TLS_CA_FILE contains no certificates")
+		}
+		config.RootCAs = roots
+	}
+	if certFile != "" {
+		certificate, err := tls.LoadX509KeyPair(certFile, keyFile)
+		if err != nil {
+			return nil, fmt.Errorf("loading Redis client certificate: %w", err)
+		}
+		config.Certificates = []tls.Certificate{certificate}
+	}
+	return config, nil
+}
