{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "updateStrategy": { "type": "string", "enum": ["RollingUpdate", "Recreate"] },
    "session": {
      "type": "object",
      "properties": {
        "idleTimeout": { "type": "string", "pattern": "^[0-9]+(h|m)$" },
        "absoluteLifetime": { "type": "string", "pattern": "^[0-9]+(h|m)$" }
      },
      "required": ["idleTimeout", "absoluteLifetime"],
      "additionalProperties": false
    },
    "shutdown": {
      "type": "object",
      "properties": {
        "preStopSleepSeconds": { "type": "integer", "minimum": 0, "maximum": 120 },
        "drainTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 }
      },
      "required": ["preStopSleepSeconds", "drainTimeoutSeconds"],
      "additionalProperties": false
    },
    "ha": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } },
      "required": ["enabled"],
      "additionalProperties": false
    },
    "databaseCASecretName": { "type": "string" },
    "dispatch": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "egressMode": { "type": "string", "enum": ["exact", "open-dev"] },
        "dev": {
          "type": "object",
          "properties": { "allowOpenEgress": { "type": "boolean" } },
          "required": ["allowOpenEgress"],
          "additionalProperties": false
        },
        "credentialsSecretName": { "type": "string" },
        "tools": {
          "type": "object",
          "properties": { "image": { "type": "string" } },
          "required": ["image"],
          "additionalProperties": false
        },
        "tunnel": {
          "type": "object",
          "properties": {
            "targetHost": { "type": "string" },
            "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "localPort": { "type": "integer", "minimum": 1024, "maximum": 65535 }
          },
          "required": ["targetHost", "targetPort", "localPort"],
          "additionalProperties": false
        },
        "ax": {
          "type": "object",
          "properties": {
            "cliSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$|^$" }
          },
          "required": ["cliSHA256"],
          "additionalProperties": false
        },
        "substrate": {
          "type": "object",
          "properties": {
            "cliSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$|^$" },
            "endpoint": { "type": "string" }
          },
          "required": ["cliSHA256", "endpoint"],
          "additionalProperties": false
        },
        "bootstrap": {
          "type": "object",
          "properties": { "routerURL": { "type": "string" } },
          "required": ["routerURL"],
          "additionalProperties": false
        },
        "clusterID": { "type": "string" },
        "leaseTTL": { "type": "string" },
        "guestRouter": { "type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?:[0-9]{1,5}$" },
        "guestRouterToken": {
          "type": "object",
          "properties": {
            "projected": { "type": "boolean" },
            "audience": { "type": "string" },
            "expirationSeconds": { "type": "integer", "minimum": 600, "maximum": 86400 }
          },
          "additionalProperties": false
        },
        "workerImage": { "type": "string" },
        "workerPool": { "type": "string" },
        "snapshotStorage": { "type": "string" },
        "workspace": { "type": "string" },
        "gateway": { "type": "string" }
      },
      "required": [
        "enabled", "egressMode", "dev", "credentialsSecretName", "tools", "tunnel", "ax",
        "substrate", "bootstrap", "clusterID", "leaseTTL", "workerImage",
        "workerPool", "snapshotStorage", "workspace", "gateway"
      ],
      "additionalProperties": false
    },
    "migrationJob": {
      "type": "object",
      "properties": { "name": { "type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" } },
      "required": ["name"],
      "additionalProperties": false
    }
  },
  "required": ["replicaCount", "ha", "migrationJob", "dispatch"]
}
