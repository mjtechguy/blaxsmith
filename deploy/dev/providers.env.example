# Blaxsmith dev: model providers for test runs
# =============================================
#
# Copy this file OUTSIDE the repo and fill in what you have:
#
#   mkdir -p ~/.config/blaxsmith-dev
#   cp deploy/dev/providers.env.example ~/.config/blaxsmith-dev/providers.env
#   chmod 600 ~/.config/blaxsmith-dev/providers.env
#
# Every line is optional: leave a value empty (or delete the line) to skip it.
# Even one key is enough to start.
#
# How it gets used: `blaxsmith admin seed-connections` reads this file on
# stdin and creates or updates a model connection in Blaxsmith for each
# provider you fill in. Keys go straight into Blaxsmith's encrypted secret
# store: they are never printed, logged, or shown to Claude. Re-running it is
# safe: connections are matched by label, and a changed key is rotated.
#
# Format: plain KEY=value, one per line. No quotes, no spaces around "=",
# no `export`. Lines starting with # are comments.


# -----------------------------------------------------------------------------
# 1. Built-in providers
# -----------------------------------------------------------------------------
# Paste a key to create a connection for that provider. Blaxsmith already knows
# each provider's endpoint and lists its models automatically when it checks
# the key.
#
# Which agent tool (harness) can use each provider:
#   Anthropic            -> Claude Code (or OpenCode)
#   OpenAI               -> Codex (or OpenCode)
#   OpenCode Go / Zen    -> OpenCode

# Anthropic API key (starts with sk-ant-api...). From console.anthropic.com.
ANTHROPIC_API_KEY=

# OpenAI API key (starts with sk-...). From platform.openai.com.
OPENAI_API_KEY=

# OpenCode Go subscription key. From opencode.ai (Go plan).
OPENCODE_GO_API_KEY=

# OpenCode Zen pay-as-you-go key. From opencode.ai (Zen).
OPENCODE_ZEN_API_KEY=


# -----------------------------------------------------------------------------
# 2. Custom endpoints (LiteLLM, a company gateway, any compatible API)
# -----------------------------------------------------------------------------
# Add as many as you like: copy the block and bump the number (_1, _2, _3...).
# Numbers don't need to be consecutive.
#
#   LABEL     A short unique name, e.g. litellm-dev. It's shown in the UI and
#             used to match on re-runs (so don't rename it casually).
#   PROVIDER  Which API the endpoint speaks:
#               openai     -> OpenAI-compatible. Use it with OpenCode. Codex
#                             works only if the endpoint also supports OpenAI's
#                             Responses API (most "OpenAI-compatible" ones only
#                             do chat completions).
#               anthropic  -> Anthropic-compatible (Messages API). Use it with
#                             Claude Code.
#               opencode-go / opencode -> an OpenCode endpoint at another URL.
#   BASE_URL  The URL the tool would call, https only.
#               OpenAI-compatible:    usually ends in /v1
#                                     e.g. https://litellm.example.com/v1
#               Anthropic-compatible: no /v1
#                                     e.g. https://litellm.example.com
#             Model auto-listing works only for public endpoints. For a private
#             one, set MODELS below, since it can't be listed.
#   API_KEY   The key that endpoint expects.
#   MODELS    Optional comma-separated model IDs, used when the endpoint can't
#             list its own models. Example: gpt-4.1,claude-sonnet-4-5

BX_ENDPOINT_1_LABEL=
BX_ENDPOINT_1_PROVIDER=openai
BX_ENDPOINT_1_BASE_URL=
BX_ENDPOINT_1_API_KEY=
BX_ENDPOINT_1_MODELS=

# BX_ENDPOINT_2_LABEL=
# BX_ENDPOINT_2_PROVIDER=anthropic
# BX_ENDPOINT_2_BASE_URL=
# BX_ENDPOINT_2_API_KEY=
# BX_ENDPOINT_2_MODELS=


# -----------------------------------------------------------------------------
# 3. Which models the test recipes use (optional)
# -----------------------------------------------------------------------------
# A Guild run has three roles:
#   PLAN       the architect: writes the plan and does the final architecture
#              review. Use your strongest model.
#   IMPLEMENT  writes the code and fixes review findings. A strong coding
#              model; can be faster or cheaper.
#   REVIEW     reviews the implementation against the plan.
#
# Format depends on the tool that will run it:
#   OpenCode:     provider/model   e.g. opencode-go/kimi-k2
#                                  (for a custom endpoint: <LABEL>/<model>,
#                                   e.g. litellm-dev/gpt-4.1)
#   Claude Code:  a Claude model   e.g. opus, sonnet, or a full model ID
#   Codex:        an OpenAI model  e.g. gpt-5.6-luna
#
# Leave these empty and Claude will pick sensible defaults from what your
# providers list. Not sure which IDs exist? Fill in the keys first and run the
# seed; it prints each connection's available models.

BX_MODEL_PLAN=
BX_MODEL_IMPLEMENT=
BX_MODEL_REVIEW=


# -----------------------------------------------------------------------------
# 4. Where the connections live (optional)
# -----------------------------------------------------------------------------
#   org       Organization connections: any project in the org can be granted
#             them. Simplest for a solo dev preview. (default)
#   personal  Your personal connections: only runs YOU launch can use them.
BX_CONNECTION_SCOPE=org
